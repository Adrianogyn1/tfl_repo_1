<!doctype html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%- include('./partials/seo-head') %>
    <script src="https://cdn.tailwindcss.com"></script>
    <!--Jquery-->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=Inter:wght@300;400;600&display=swap"
        rel="stylesheet" />
    <style>
        :root {
            --font-display: "Outfit", sans-serif;
            --font-body: "Inter", sans-serif;
        }

        body {
            background-color: #050505;
            scroll-behavior: smooth;
            font-family: var(--font-body);
        }

        h1,
        h2,
        h3,
        .font-display {
            font-family: var(--font-display);
        }

        .hero-gradient {
            background: radial-gradient(circle at 50% -20%,
                    #1e40af 0%,
                    #050505 60%);
        }

        .glass {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .img-placeholder {
            background: linear-gradient(45deg, #111, #1a1a1a);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 1.5rem;
            min-width: 300px;
            height: 450px;
            border: 1px dashed rgba(255, 255, 255, 0.1);
            transition: transform 0.3s ease;
            overflow: hidden;
            background-size: cover;
            background-position: center;
        }

        .img-placeholder:hover {
            transform: scale(1.02);
            border-color: #3b82f6;
        }
    </style>
</head>

<body class="text-zinc-200">
    <nav class="fixed w-full z-50 border-b border-white/5 bg-black/60 backdrop-blur-xl">
        <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <img src="/static/images/Icon_tfl.png" alt="The Fantasy Life" class="w-10 h-10">
                <div class="text-xl font-display font-black tracking-tight uppercase italic">
                    The <span class="text-blue-500">Fantasy</span> Life
                </div>
            </div>
            <div class="hidden md:flex gap-8 text-sm font-medium text-zinc-400 items-center">
                <a href="#vibe" class="hover:text-white transition">
                    <%= t('home.nav.play', {}, 'home.nav.play' ) || 'Jogue' %>
                </a>
                <a href="#galeria" class="hover:text-white transition">
                    <%= t('home.nav.explore', {}, 'home.nav.explore' ) || 'Explorar' %>
                </a>
                <a href="#apoio" class="hover:text-blue-400 transition">
                    <%= t('home.nav.support', {}, 'home.nav.support' ) || 'Apoiar' %>
                </a>
                <a href="/profile"
                    class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white rounded-xl transition text-xs font-bold uppercase tracking-wider">
                    <%= t('home.nav.login', {}, 'home.nav.login' ) || 'Entrar' %>
                </a>
            </div>
        </div>
    </nav>

    <section class="hero-gradient pt-44 pb-20 px-6 text-center">
        <div class="max-w-3xl mx-auto">
            <h1 class="text-5xl md:text-7xl font-black mb-6 tracking-tight text-white leading-tight">
                <%= t('home.hero.title', {}, 'home.hero.title' ) || 'Constrói a tua história. Experimenta o novo.' %>
            </h1>
            <p class="text-lg text-zinc-400 mb-8 font-normal italic">
                <%= t('home.hero.subtitle', {}, 'home.hero.subtitle' )
                    || 'No The Fantasy Life, o foco é a liberdade. Um mundo aberto para quem quer fazer parte de algo autêntico e construir conexões reais.'
                    %>
            </p>

            <!-- Plataformas Disponíveis -->
            <div class="flex justify-center items-center gap-8 opacity-50">
                <div id="trigger-windows" class="download-trigger flex flex-col items-center gap-2 cursor-pointer"
                    data-platform="windows">
                    <i class="fa-brands fa-windows text-2xl"></i>
                    <span class="text-[10px] uppercase font-bold tracking-widest">Windows</span>
                </div>
                <div id="trigger-android" class="download-trigger flex flex-col items-center gap-2 cursor-pointer"
                    data-platform="android">
                    <i class="fa-brands fa-android text-2xl"></i>
                    <span class="text-[10px] uppercase font-bold tracking-widest">Android</span>
                </div>
                <div id="trigger-linux" class="download-trigger flex flex-col items-center gap-2 cursor-pointer"
                    data-platform="linux">
                    <i class="fa-brands fa-linux text-2xl"></i>
                    <span class="text-[10px] uppercase font-bold tracking-widest">Linux</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Carrossel de Imagens -->
    <section id="galeria" class="py-10">
        <div class="px-6 mb-6 max-w-7xl mx-auto flex justify-between items-end">
            <div>
                <span class="text-blue-500 text-xs font-bold uppercase tracking-widest">
                    <%= t('home.gallery.tag', {}, 'home.gallery.tag' ) || 'Galeria' %>
                </span>
                <h2 class="text-3xl font-black tracking-tighter uppercase italic">
                    <%= t('home.gallery.title', {}, 'home.gallery.title' ) || 'Explora o Mundo' %>
                </h2>
            </div>
            <span class="text-zinc-600 text-xs hidden md:block italic">
                <%= t('home.gallery.scroll', {}, 'home.gallery.scroll' ) || 'Scroll horizontal para ver mais →' %>
            </span>
        </div>
        <div id="galeria-container" class="flex gap-6 overflow-x-auto px-6 no-scrollbar snap-x snap-mandatory">
            <!-- As imagens serão carregadas dinamicamente aqui -->
        </div>
    </section>

    <!-- Vibe Secção -->
    <section id="vibe" class="py-24 px-6 bg-[#080808]">
        <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-16 items-center">
            <div>
                <h2 class="text-4xl font-black mb-6 uppercase italic tracking-tighter">
                    <%= t('home.vibe.title', {}, 'home.vibe.title' ) || 'Liberdade sem rótulos.' %>
                </h2>
                <div class="space-y-6 text-zinc-400">
                    <p>
                        <%= t('home.vibe.desc', {}, 'home.vibe.desc' )
                            || 'Criámos um espaço onde o digital encontra o conforto. Aqui, a prioridade é a tua experiência e a forma como interages com o meio.'
                            %>
                    </p>
                    <ul class="space-y-4">
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-check-circle text-blue-500 mt-1"></i>
                            <span><strong>
                                    <%= t('home.vibe.item1Title', {}, 'home.vibe.item1Title' ) || 'Ambiente Dinâmico:'
                                        %>
                                </strong>
                                <%= t('home.vibe.item1Desc', {}, 'home.vibe.item1Desc' )
                                    || 'Eventos criados pela comunidade e para a comunidade.' %>
                            </span>
                        </li>
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-check-circle text-blue-500 mt-1"></i>
                            <span><strong>
                                    <%= t('home.vibe.item2Title', {}, 'home.vibe.item2Title' ) || 'Experimenta Tudo:' %>
                                </strong>
                                <%= t('home.vibe.item2Desc', {}, 'home.vibe.item2Desc' )
                                    || 'Do relaxamento total à construção de impérios, tu decides.' %>
                            </span>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="glass p-10 rounded-[3rem] text-center border-blue-500/20 shadow-2xl">
                <i class="fa-solid fa-sparkles text-5xl text-blue-500 mb-6"></i>
                <h3 class="text-2xl font-bold mb-4 uppercase italic">
                    <%= t('home.vibe.cardTitle', {}, 'home.vibe.cardTitle' ) || 'Vem experimentar' %>
                </h3>
                <p class="text-zinc-500 mb-8">
                    <%= t('home.vibe.cardDesc', {}, 'home.vibe.cardDesc' )
                        || 'Junta-te aos utilizadores que já estão a moldar este novo mundo. Garante o teu acesso.' %>
                </p>
                <a href="/register"
                    class="inline-block w-full bg-blue-600 text-white py-4 rounded-2xl font-black hover:bg-blue-500 transition uppercase text-sm tracking-widest text-center">
                    <%= t('home.vibe.cardButton', {}, 'home.vibe.cardButton' ) || 'Entre em nossa comunidade' %>
                </a>
            </div>
        </div>
    </section>

    <!-- Doação / Apoio -->
    <section id="apoio" class="py-24 px-6 border-t border-white/5">
        <div class="max-w-4xl mx-auto text-center">
            <span class="text-blue-500 text-xs font-bold uppercase tracking-widest mb-4 block">
                <%= t('home.support.tag', {}, 'home.support.tag' ) || 'Contribuir' %>
            </span>
            <h2 class="text-4xl font-black mb-6 uppercase italic tracking-tighter">
                <%= t('home.support.title', {}, 'home.support.title' ) || 'Mantém o Sonho Vivo' %>
            </h2>
            <p class="text-zinc-400 mb-10 leading-relaxed italic">
                <%= t('home.support.desc', {}, 'home.support.desc' )
                    || 'O The Fantasy Life é um projeto independente. Qualquer apoio ajuda a manter os nossos servidores estáveis e a equipa focada em criar novas experiências.'
                    %>
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 justify-center">
                <div id="donate-cafe"
                    class="donate-trigger glass p-6 rounded-2xl hover:border-blue-500/50 transition cursor-pointer md:col-start-2"
                    data-type="cafe">
                    <i class="fa-solid fa-mug-hot text-blue-500 text-2xl mb-4"></i>
                    <h4 class="font-bold mb-2">
                        <%= t('home.support.coffeeTitle', {}, 'home.support.coffeeTitle' ) || 'Um Café' %>
                    </h4>
                    <p class="text-xs text-zinc-500">
                        <%= t('home.support.coffeeDesc', {}, 'home.support.coffeeDesc' )
                            || 'Apoio simbólico para energia extra. Apoie-nos!' %>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <footer class="py-12 border-t border-zinc-900 bg-zinc-950 px-6 mt-16">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="text-center md:text-left">
                <div class="text-base font-display font-black uppercase italic text-white">
                    The <span class="text-blue-500">Fantasy</span> Life
                </div>
                <p class="text-zinc-500 text-xs italic">
                    <%= t('home.footer.slogan', {}, 'home.footer.slogan' ) || 'Onde a tua imaginação ganha forma digital.' %>
                </p>
            </div>

            <!-- Links Úteis Secundários no Rodapé (sem poluir o visual da Home) -->
            <div class="flex flex-wrap items-center justify-center gap-2.5 text-xs">
                <a href="/contato" class="px-3 py-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-blue-500/40 text-zinc-400 hover:text-white transition flex items-center gap-1.5" title="<%= t('home.footer.contact', {}, 'Contato') %>">
                    <span class="material-symbols-outlined text-[15px] text-blue-400">mail</span>
                    <span><%= t('home.footer.contact', {}, 'Contato') %></span>
                </a>

                <a href="/reportar-bug" class="px-3 py-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-rose-500/40 text-zinc-400 hover:text-white transition flex items-center gap-1.5" title="<%= t('home.footer.reportBug', {}, 'Reportar Bug') %>">
                    <span class="material-symbols-outlined text-[15px] text-rose-400">bug_report</span>
                    <span><%= t('home.footer.reportBug', {}, 'Reportar Bug') %></span>
                </a>

                <a href="/sugestoes" class="px-3 py-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-amber-500/40 text-zinc-400 hover:text-white transition flex items-center gap-1.5" title="<%= t('home.footer.suggestions', {}, 'Sugestões') %>">
                    <span class="material-symbols-outlined text-[15px] text-amber-400">lightbulb</span>
                    <span><%= t('home.footer.suggestions', {}, 'Sugestões') %></span>
                </a>

                <a href="/tutorial" class="px-3 py-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-cyan-500/40 text-zinc-400 hover:text-white transition flex items-center gap-1.5" title="<%= t('home.footer.tutorial', {}, 'Tutorial') %>">
                    <span class="material-symbols-outlined text-[15px] text-cyan-400">help</span>
                    <span><%= t('home.footer.tutorial', {}, 'Tutorial') %></span>
                </a>

                <a href="/changelog" class="px-3 py-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-emerald-500/40 text-zinc-400 hover:text-white font-mono transition flex items-center gap-1.5" title="<%= t('home.footer.version', {}, 'Notas da Versão') %>">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>v<%= typeof version !== 'undefined' ? version : '0.00042' %></span>
                </a>

                <div class="flex items-center gap-2 bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-1.5">
                    <span class="material-symbols-outlined text-[15px] text-zinc-400">translate</span>
                    <select id="langSelect"
                        aria-label="Selecionar Idioma"
                        class="bg-transparent text-zinc-200 text-xs font-semibold focus:outline-none cursor-pointer">
                        <option value="pt-BR" class="bg-zinc-900">Português (Brasil)</option>
                        <option value="en-US" class="bg-zinc-900">English (US)</option>
                        <option value="es-ES" class="bg-zinc-900">Español</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="text-center mt-6 text-zinc-600 text-[10px]">
            © The Fantasy Life. <%= t('home.footer.rights', {}, 'home.footer.rights' ) || 'Todos os direitos reservados.' %>
        </div>
    </footer>

    <!-- Modal de Download -->
    <div id="modal-download"
        class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-zinc-900 border border-white/10 p-6 rounded-2xl relative max-w-md w-full shadow-2xl">
            <button id="btn-close-modal"
                class="absolute top-4 right-4 text-gray-400 hover:text-white text-2xl font-bold">&times;</button>
            <h3 class="text-lg font-bold mb-4 uppercase italic">
                <%= t('home.modal.downloadTitle', {}, 'home.modal.downloadTitle' ) || 'Baixe o The Fantasy Life' %>
            </h3>
            <div id="download-options-container" class="grid grid-cols-2 gap-4">
                <a id="link-windows" href="#" target="_blank"
                    class="download-item p-4 bg-zinc-800 rounded-xl hover:bg-blue-600 transition flex flex-col items-center gap-2 text-center group">
                    <i class="fa-brands fa-windows text-3xl group-hover:scale-110 transition"></i>
                    <span class="text-xs font-bold">Windows</span>
                </a>
                <a id="link-linux" href="#" target="_blank"
                    class="download-item p-4 bg-zinc-800 rounded-xl hover:bg-blue-600 transition flex flex-col items-center gap-2 text-center group">
                    <i class="fa-brands fa-linux text-3xl group-hover:scale-110 transition"></i>
                    <span class="text-xs font-bold">Linux</span>
                </a>
                <a id="link-android" href="#" target="_blank"
                    class="download-item p-4 bg-zinc-800 rounded-xl hover:bg-blue-600 transition flex flex-col items-center gap-2 text-center group">
                    <i class="fa-brands fa-android text-3xl group-hover:scale-110 transition"></i>
                    <span class="text-xs font-bold">Android</span>
                </a>
                <a id="link-ios" href="#" target="_blank"
                    class="download-item p-4 bg-zinc-800 rounded-xl hover:bg-blue-600 transition flex flex-col items-center gap-2 text-center group">
                    <i class="fa-brands fa-apple text-3xl group-hover:scale-110 transition"></i>
                    <span class="text-xs font-bold">iOS</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Modal de Doação / Apoio -->
    <div id="modal-donate"
        class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-zinc-900 border border-white/10 p-6 rounded-2xl relative max-w-md w-full shadow-2xl text-center">
            <button id="btn-close-donate"
                class="absolute top-4 right-4 text-gray-400 hover:text-white text-2xl font-bold">&times;</button>
            <h3 id="donate-modal-title" class="text-lg font-bold mb-2 uppercase italic">
                <%= t('home.modal.donateTitle', {}, 'home.modal.donateTitle' ) || 'Apoiar o Projeto' %>
            </h3>
            <p id="donate-modal-desc" class="text-xs text-zinc-400 mb-6">
                <%= t('home.modal.donateDesc', {}, 'home.modal.donateDesc' )
                    || 'Obrigado por ajudar a manter o The Fantasy Life ativo!' %>
            </p>

            <div class="space-y-4">
                <div id="donate-pix-container">
                    <label class="block text-xs font-bold text-zinc-500 uppercase mb-2">
                        <%= t('home.modal.pixKey', {}, 'home.modal.pixKey' ) || 'Chave Pix / Copia e Cola' %>
                    </label>
                    <div class="flex gap-2">
                        <input id="input-pix-key" type="text" readonly
                            class="w-full bg-zinc-800 border border-white/10 rounded-xl px-3 text-xs text-zinc-300 focus:outline-none" />
                        <button id="btn-copy-pix"
                            class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-xl text-xs font-bold transition">
                            <%= t('home.modal.copy', {}, 'home.modal.copy' ) || 'Copiar' %>
                        </button>
                    </div>
                </div>

                <div id="donate-image-container">
                    <label class="block text-xs font-bold text-zinc-500 uppercase mb-2">
                        <%= t('home.modal.pixImage', {}, 'home.modal.pixImage' ) || 'Imagem Pix' %>
                    </label>
                    <img id="donate-image" src="" alt="Imagem Pix" class="w-full rounded-xl" />
                </div>
            </div>
        </div>
    </div>
</body>
<script>
    $(document).ready(function ()
    {
        buscarInfo();

        function getCookie(name)
        {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        const currentLang = getCookie('lang') || 'pt-BR';
        $('#langSelect').val(currentLang);

        $('#langSelect').on('change', function ()
        {
            const selectedLang = $(this).val();
            document.cookie = `lang=${selectedLang}; path=/; max-age=31536000`;
            location.reload();
        });

        $(".download-trigger").hover(function ()
        {
            $(this).addClass("animate-bounce");
        }, function ()
        {
            $(this).removeClass("animate-bounce");
        }).click(function ()
        {
            $("#modal-download").removeClass("hidden");
        });

        $("#btn-close-modal").click(function ()
        {
            $("#modal-download").addClass("hidden");
        });

        $(".donate-trigger").click(async function ()
        {
            const dominio = window.location.origin.endsWith("/") ? window.location.origin.slice(0, -1) : window.location.origin;
            $.get(dominio + "/asaas/qrcode", function (data)
            {
                $("#modal-donate").removeClass("hidden");
                $("#input-pix-key").val(data.payload);
                $("#donate-image").attr("src", data.encodedImage);
            })
        });

        $("#btn-close-donate").click(function ()
        {
            $("#modal-donate").addClass("hidden");
        });

        $("#btn-copy-pix").click(function ()
        {
            var copyText = document.getElementById("input-pix-key");
            copyText.select();
            copyText.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(copyText.value);
            $(this).text("<%= t('home.modal.copied', {}, 'home.modal.copied') || 'Copiado!' %>").addClass("bg-green-600");
            setTimeout(() =>
            {
                $(this).text("<%= t('home.modal.copy', {}, 'home.modal.copy') || 'Copiar' %>").removeClass("bg-green-600");
            }, 2000);
        });

        $(document).keydown(function (e) {
            if (e.key === "Escape") {
                $("#modal-download").addClass("hidden");
                $("#modal-donate").addClass("hidden");
            }
        });

        $(window).click(function (e)
        {
            if ($(e.target).is("#modal-download"))
            {
                $("#modal-download").addClass("hidden");
            }
            if ($(e.target).is("#modal-donate"))
            {
                $("#modal-donate").addClass("hidden");
            }
        });

        function buscarInfo()
        {
            var url = "./api/home/info";
            $.get(url, function (data)
            {
                if (data && data.version)
                {
                    $('#clModalVersionBadge').text('v' + data.version);
                }
                if (data)
                {
                    if (data.images)
                    {
                        var container = $("#galeria-container");
                        container.empty();
                        $.each(data.images, function (imgUrl, info)
                        {
                            if (info.active)
                            {
                                var card = $('<div class="img-placeholder snap-center"></div>');
                                card.css("background-image", "url('" + imgUrl + "')");
                                container.append(card);
                            }
                        });
                    }

                    if (data.files)
                    {
                        var files = data.files;
                        ['windows', 'linux', 'android', 'ios'].forEach(function (platform)
                        {
                            var item = files[platform];
                            var $link =$("#link-" + platform);
                            if (item)
                            {
                                if (item.active && item.url)
                                {
                                    $link.attr("href", item.url).show();
                                } else if (!item.active)
                                {
                                    $link.hide();
                                } else
                                {
                                    $link.attr("href", "#").attr("onclick", "if(window.Swal){Swal.fire({icon:'info',title:'Em Breve',text:'Esta versão estará disponível em breve!',background:'#18181b',color:'#fff'});}else{console.log('Versão indisponível');} return false;").show();
                                }
                            }
                        });
                    }

                    if (data.pix)
                    {
                        $('#donate-pix-container').show();
                        $('#donate-image-container').show();
                        $('#donate-image').attr('src', data.pix.image);
                        $('#input-pix-key').val(data.pix.payload);
                    }
                }
            }).fail(function ()
            {
                $("#donate-pix-container").hide();
                $("#donate-external-container").hide();
            });
        }
    });
</script>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-SH2MFXDN52"></script>
<script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());

    gtag('config', 'G-SH2MFXDN52');
</script>

</html>