<!-- ================= JANELA / MODAL: MINI PROFILE DO AVATAR ================= -->
<div id="modalMiniProfile" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-white/15 rounded-3xl max-w-sm w-full shadow-2xl overflow-hidden">
        <!-- Capa Mini Profile -->
        <div class="h-28 bg-gradient-to-r from-blue-600/40 via-sky-500/30 to-purple-600/40 relative overflow-hidden">
            <img id="miniProfileCoverImg" src="" alt="Capa" class="hidden w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent"></div>
            <button type="button" class="btn-close-modal absolute top-3 right-3 w-8 h-8 rounded-full bg-black/60 hover:bg-black text-zinc-300 hover:text-white flex items-center justify-center text-lg transition z-10">&times;</button>
        </div>

        <div class="px-6 pb-6 -mt-12 relative space-y-4">
            <!-- Avatar e Identificação -->
            <div class="flex items-end justify-between gap-3">
                <div class="w-24 h-24 rounded-2xl overflow-hidden border-4 border-slate-900 bg-slate-950 shadow-xl flex-shrink-0">
                    <img id="miniProfileImg" src="" alt="Avatar" class="w-full h-full object-cover">
                </div>
                <div class="flex items-center gap-1.5 mb-1">
                    <span id="miniProfileMatchPill" class="hidden px-2 py-1 rounded-lg bg-pink-500/20 border border-pink-500/40 text-[10px] font-black text-pink-300">💘 Match</span>
                    <span id="miniProfileLastSeenBadge" class="px-2.5 py-1 rounded-lg bg-slate-950 border border-white/10 text-[10px] font-medium text-emerald-400 flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span id="miniProfileLastSeenText">Visto recentemente</span>
                    </span>
                </div>
            </div>

            <div>
                <div class="flex items-center gap-2 flex-wrap">
                    <h4 id="miniProfileName" class="text-base font-black uppercase italic text-white truncate">Avatar</h4>
                    <span id="miniProfileGender" class="px-2 py-0.5 rounded bg-blue-500/15 text-blue-400 text-[10px] font-bold">Viajante</span>
                    <span id="miniProfileFeelingBadge" class="hidden px-2 py-0.5 rounded-full bg-amber-500/20 border border-amber-400/30 text-amber-300 text-[10px] font-bold"></span>
                </div>
                <p id="miniProfileBio" class="text-xs text-zinc-400 mt-1 line-clamp-3">Biografia...</p>
            </div>

            <!-- Contadores Rápidos -->
            <div class="grid grid-cols-5 gap-1.5 p-2.5 rounded-2xl bg-slate-950 border border-white/5 text-center">
                <div>
                    <div id="miniProfilePosts" class="text-xs font-black text-white">0</div>
                    <div class="text-[8px] text-zinc-500 uppercase font-bold">Posts</div>
                </div>
                <div>
                    <div id="miniProfileFriends" class="text-xs font-black text-emerald-400">0</div>
                    <div class="text-[8px] text-zinc-500 uppercase font-bold">Amigos</div>
                </div>
                <div>
                    <div id="miniProfileFollowers" class="text-xs font-black text-sky-400">0</div>
                    <div class="text-[8px] text-zinc-500 uppercase font-bold">Seguidores</div>
                </div>
                <div>
                    <div id="miniProfileRooms" class="text-xs font-black text-purple-400">0</div>
                    <div class="text-[8px] text-zinc-500 uppercase font-bold">Salas</div>
                </div>
                <div>
                    <div id="miniProfileLikes" class="text-xs font-black text-rose-400">0</div>
                    <div class="text-[8px] text-zinc-500 uppercase font-bold">Curtidas</div>
                </div>
            </div>

            <!-- Botões de Ação do Mini Profile -->
            <div id="miniProfileActions" class="space-y-2 pt-1"></div>
        </div>
    </div>
</div>

<!-- ================= JANELA / MODAL: VISUALIZADOR DE FOTO (CURTIR E COMENTAR IMAGEM) ================= -->
<div id="modalPhotoViewer" class="hidden fixed inset-0 bg-black/90 backdrop-blur-md flex items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-white/15 rounded-3xl max-w-4xl w-full shadow-2xl overflow-hidden grid grid-cols-1 md:grid-cols-12 max-h-[90vh]">
        <!-- Coluna da Imagem (7 colunas) -->
        <div class="md:col-span-7 bg-black flex items-center justify-center relative min-h-[260px] max-h-[55vh] md:max-h-[90vh] overflow-hidden">
            <img id="photoViewerImg" src="" alt="Foto" class="max-w-full max-h-[55vh] md:max-h-[85vh] object-contain">
        </div>

        <!-- Coluna de Curtidas, Reações e Comentários Recursivos da Foto (5 colunas) -->
        <div class="md:col-span-5 flex flex-col max-h-[85vh] bg-slate-900 border-l border-white/10">
            <!-- Topo: Autor da Foto + Fechar -->
            <div class="p-4 border-b border-white/10 flex items-center justify-between gap-2">
                <div id="photoViewerAuthorBox" class="flex items-center gap-2.5 overflow-hidden"></div>
                <button type="button" class="btn-close-modal w-8 h-8 rounded-full bg-slate-800 hover:bg-red-600 text-zinc-300 hover:text-white flex items-center justify-center text-lg transition">&times;</button>
            </div>

            <!-- Descrição e Reações da Foto -->
            <div class="px-4 py-3 border-b border-white/10 space-y-2.5 bg-slate-950/50">
                <p id="photoViewerDescription" class="text-xs text-zinc-300 break-words"></p>
                <div id="photoViewerReactionBar" class="flex flex-wrap items-center justify-between gap-2"></div>
            </div>

            <!-- Lista de Comentários Recursivos da Foto -->
            <div id="photoViewerCommentsList" class="flex-1 overflow-y-auto p-4 space-y-2.5"></div>

            <!-- Formulário para Comentar na Foto -->
            <form id="formCommentPhoto" class="p-3.5 border-t border-white/10 bg-slate-950 flex items-center gap-2">
                <input type="hidden" id="activePhotoViewerId" value="">
                <input type="text" id="inputCommentPhotoText" placeholder="Comentar nesta foto..."
                       class="flex-1 bg-slate-900 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-sky-500">
                <button type="submit" class="px-4 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-xs font-bold transition">
                    Enviar
                </button>
            </form>
        </div>
    </div>
</div>

<!-- ================= JANELA / MODAL: ADICIONAR FOTO DIRETO NA GALERIA ================= -->
<div id="modalUploadGalleryPhoto" class="hidden fixed inset-0 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-white/15 rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <h4 class="text-sm font-black uppercase italic text-white flex items-center gap-2">
                <i class="fa-solid fa-images text-amber-400"></i>
                Adicionar Foto na Galeria
            </h4>
            <button type="button" class="btn-close-modal text-zinc-400 hover:text-white text-xl">&times;</button>
        </div>

        <form id="formUploadGalleryPhoto" class="space-y-4">
            <input type="file" id="fileGalleryPhotoUpload" accept="image/*" class="hidden">
            <input type="hidden" id="inputGalleryPhotoUrl" value="">

            <div id="galleryUploadDropArea" class="p-6 rounded-2xl bg-slate-950 border-2 border-dashed border-white/15 hover:border-amber-400 text-center cursor-pointer transition space-y-2">
                <img id="galleryUploadPreviewImg" src="" alt="Preview" class="hidden max-h-48 mx-auto rounded-xl object-contain mb-2">
                <i id="galleryUploadIcon" class="fa-solid fa-cloud-arrow-up text-3xl text-amber-400"></i>
                <p id="labelGalleryUploadStatus" class="text-xs font-bold text-zinc-300">Clique para selecionar uma foto (Sem vídeos)</p>
                <p class="text-[10px] text-zinc-500">Formatos de imagem: PNG, JPG, WEBP, GIF</p>
            </div>

            <div>
                <label class="block text-xs font-bold text-zinc-400 uppercase mb-1.5">Legenda / Descrição da Foto</label>
                <textarea id="inputGalleryPhotoDesc" rows="2" placeholder="Escreva uma legenda opcional para esta foto..."
                          class="w-full bg-slate-950 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500 resize-none"></textarea>
            </div>

            <label class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-950 border border-white/5 cursor-pointer text-xs text-zinc-300">
                <input type="checkbox" id="chkShareGalleryOnFeed" checked class="w-4 h-4 accent-amber-500 rounded">
                <span>Compartilhar também no Feed Social</span>
            </label>

            <button type="submit" id="btnSubmitGalleryPhoto" class="w-full py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs uppercase tracking-wider transition shadow-lg shadow-amber-500/20">
                Salvar Foto na Galeria
            </button>
        </form>
    </div>
</div>

<!-- ================= JANELA / MODAL: CRIAR MINI REEL (24H FOTO/TEXTO) OU SENTIMENTO (6H) ================= -->
<div id="modalCreateMiniReel" class="hidden fixed inset-0 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-white/15 rounded-3xl max-w-lg w-full p-6 shadow-2xl space-y-4 max-h-[92vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <div>
                <h4 class="text-sm font-black uppercase italic text-white flex items-center gap-2">
                    <i class="fa-solid fa-bolt text-pink-400"></i>
                    Criar Mini Reel ou Sentimento
                </h4>
                <p class="text-[10px] text-zinc-400">Sem vídeos • Sentimento dura <strong>6 horas</strong> • Foto e Texto duram <strong>24 horas</strong></p>
            </div>
            <button type="button" class="btn-close-modal text-zinc-400 hover:text-white text-xl">&times;</button>
        </div>

        <!-- Seletor de Modo: Foto (24h) | Texto (24h) | Sentimento (6h) -->
        <div class="grid grid-cols-3 gap-2 p-1.5 rounded-2xl bg-slate-950 border border-white/10">
            <button type="button" class="btn-reel-mode-tab py-2 rounded-xl text-xs font-black uppercase transition bg-pink-600 text-white" data-mode="photo">
                📸 Foto (24h)
            </button>
            <button type="button" class="btn-reel-mode-tab py-2 rounded-xl text-xs font-black uppercase transition text-zinc-400 hover:text-white" data-mode="text">
                ✍️ Texto (24h)
            </button>
            <button type="button" class="btn-reel-mode-tab py-2 rounded-xl text-xs font-black uppercase transition text-zinc-400 hover:text-white" data-mode="feeling">
                😊 Sentimento (6h)
            </button>
        </div>

        <form id="formCreateMiniReel" class="space-y-4">
            <input type="hidden" id="inputReelType" value="photo">
            <input type="hidden" id="inputReelImageUrl" value="">
            <input type="hidden" id="inputReelFeelingEmoji" value="">
            <input type="hidden" id="inputReelFeelingLabel" value="">
            <input type="hidden" id="inputReelBgStyle" value="from-blue-700 via-indigo-800 to-purple-900">
            <input type="file" id="fileMiniReelImage" accept="image/*" class="hidden">

            <!-- Seção de Upload de Foto (Visível quando modo === 'photo') -->
            <div id="reelPhotoInputSection" class="space-y-2.5">
                <div id="btnTriggerReelImageUpload" class="p-5 rounded-2xl bg-slate-950 border-2 border-dashed border-white/15 hover:border-pink-500 text-center cursor-pointer transition space-y-2">
                    <img id="reelPreviewImage" src="" alt="Preview" class="hidden max-h-48 mx-auto rounded-xl object-contain mb-2">
                    <i class="fa-solid fa-camera text-2xl text-pink-400"></i>
                    <p id="labelReelUploadPhoto" class="text-xs font-bold text-zinc-300">Escolher Foto para o Mini Reel (Dura 24 horas)</p>
                    <p class="text-[10px] text-zinc-500">Somente imagens (sem vídeos)</p>
                </div>
                <label class="flex items-center gap-2 text-xs text-zinc-300 cursor-pointer px-1">
                    <input type="checkbox" id="chkSaveReelPhotoToGallery" checked class="w-4 h-4 accent-pink-500 rounded">
                    <span>Salvar esta foto também na minha Galeria de Fotos</span>
                </label>
            </div>

            <!-- Seção de Cor de Fundo (Visível quando modo === 'text' ou 'feeling') -->
            <div id="reelBgStyleSection" class="hidden space-y-1.5">
                <label class="block text-[11px] font-bold text-zinc-400 uppercase">Estilo de Fundo do Card</label>
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" class="btn-pick-reel-bg w-8 h-8 rounded-xl bg-gradient-to-br from-blue-700 via-indigo-800 to-purple-900 ring-2 ring-white" data-bg="from-blue-700 via-indigo-800 to-purple-900"></button>
                    <button type="button" class="btn-pick-reel-bg w-8 h-8 rounded-xl bg-gradient-to-br from-pink-600 via-rose-700 to-amber-700" data-bg="from-pink-600 via-rose-700 to-amber-700"></button>
                    <button type="button" class="btn-pick-reel-bg w-8 h-8 rounded-xl bg-gradient-to-br from-emerald-600 via-teal-800 to-slate-900" data-bg="from-emerald-600 via-teal-800 to-slate-900"></button>
                    <button type="button" class="btn-pick-reel-bg w-8 h-8 rounded-xl bg-gradient-to-br from-amber-500 via-orange-700 to-red-900" data-bg="from-amber-500 via-orange-700 to-red-900"></button>
                    <button type="button" class="btn-pick-reel-bg w-8 h-8 rounded-xl bg-gradient-to-br from-purple-700 via-fuchsia-800 to-slate-950" data-bg="from-purple-700 via-fuchsia-800 to-slate-950"></button>
                </div>
            </div>

            <!-- Seção de Sentimento (Obrigatório no modo 'feeling', opcional nos modos 'photo'/'text' — Dura 6 horas!) -->
            <div class="p-3.5 rounded-2xl bg-slate-950 border border-amber-500/20 space-y-2.5">
                <div class="flex items-center justify-between">
                    <label class="text-[11px] font-black uppercase text-amber-400 flex items-center gap-1.5">
                        <span>😊</span>
                        <span>Como você está se sentindo neste momento? (Dura 6h)</span>
                    </label>
                    <button type="button" id="btnClearReelFeeling" class="hidden text-[10px] text-zinc-400 hover:text-red-400 font-bold">Limpar</button>
                </div>
                <div class="grid grid-cols-3 sm:grid-cols-4 gap-1.5" id="reelFeelingOptionsGrid">
                    <button type="button" class="btn-pick-feeling p-2 rounded-xl bg-slate-900 hover:bg-amber-500/20 border border-white/5 text-left text-[11px] text-zinc-200 flex items-center gap-1.5 transition" data-emoji="😊" data-label="Feliz"><span>😊</span><span class="truncate">Feliz</span></button>
                    <button type="button" class="btn-pick-feeling p-2 rounded-xl bg-slate-900 hover:bg-amber-500/20 border border-white/5 text-left text-[11px] text-zinc-200 flex items-center gap-1.5 transition" data-emoji="🤩" data-label="Animado"><span>🤩</span><span class="truncate">Animado</span></button>
                    <button type="button" class="btn-pick-feeling p-2 rounded-xl bg-slate-900 hover:bg-amber-500/20 border border-white/5 text-left text-[11px] text-zinc-200 flex items-center gap-1.5 transition" data-emoji="🥰" data-label="Apaixonado"><span>🥰</span><span class="truncate">Apaixonado</span></button>
                    <button type="button" class="btn-pick-feeling p-2 rounded-xl bg-slate-900 hover:bg-amber-500/20 border border-white/5 text-left text-[11px] text-zinc-200 flex items-center gap-1.5 transition" data-emoji="😎" data-label="De boa"><span>😎</span><span class="truncate">De boa</span></button>
                    <button type="button" class="btn-pick-feeling p-2 rounded-xl bg-slate-900 hover:bg-amber-500/20 border border-white/5 text-left text-[11px] text-zinc-200 flex items-center gap-1.5 transition" data-emoji="🎮" data-label="Jogando"><span>🎮</span><span class="truncate">Jogando</span></button>
                    <button type="button" class="btn-pick-feeling p-2 rounded-xl bg-slate-900 hover:bg-amber-500/20 border border-white/5 text-left text-[11px] text-zinc-200 flex items-center gap-1.5 transition" data-emoji="🥳" data-label="Festejando"><span>🥳</span><span class="truncate">Festejando</span></button>
                    <button type="button" class="btn-pick-feeling p-2 rounded-xl bg-slate-900 hover:bg-amber-500/20 border border-white/5 text-left text-[11px] text-zinc-200 flex items-center gap-1.5 transition" data-emoji="💭" data-label="Pensativo"><span>💭</span><span class="truncate">Pensativo</span></button>
                    <button type="button" class="btn-pick-feeling p-2 rounded-xl bg-slate-900 hover:bg-amber-500/20 border border-white/5 text-left text-[11px] text-zinc-200 flex items-center gap-1.5 transition" data-emoji="🔥" data-label="Focado"><span>🔥</span><span class="truncate">Focado</span></button>
                    <button type="button" class="btn-pick-feeling p-2 rounded-xl bg-slate-900 hover:bg-amber-500/20 border border-white/5 text-left text-[11px] text-zinc-200 flex items-center gap-1.5 transition" data-emoji="😴" data-label="Com sono"><span>😴</span><span class="truncate">Com sono</span></button>
                    <button type="button" class="btn-pick-feeling p-2 rounded-xl bg-slate-900 hover:bg-amber-500/20 border border-white/5 text-left text-[11px] text-zinc-200 flex items-center gap-1.5 transition" data-emoji="☕" data-label="Relaxando"><span>☕</span><span class="truncate">Relaxando</span></button>
                    <button type="button" class="btn-pick-feeling p-2 rounded-xl bg-slate-900 hover:bg-amber-500/20 border border-white/5 text-left text-[11px] text-zinc-200 flex items-center gap-1.5 transition" data-emoji="😢" data-label="Triste"><span>😢</span><span class="truncate">Triste</span></button>
                    <button type="button" class="btn-pick-feeling p-2 rounded-xl bg-slate-900 hover:bg-amber-500/20 border border-white/5 text-left text-[11px] text-zinc-200 flex items-center gap-1.5 transition" data-emoji="😡" data-label="Irritado"><span>😡</span><span class="truncate">Irritado</span></button>
                </div>
            </div>

            <!-- Texto / Frase do Mini Reel -->
            <div>
                <label id="labelReelTextInput" class="block text-xs font-bold text-zinc-400 uppercase mb-1.5">Texto ou Legenda (Dura 24h em Fotos/Texto)</label>
                <textarea id="inputReelText" rows="3" maxlength="280" placeholder="Escreva algo para o seu Mini Reel..."
                          class="w-full bg-slate-950 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-pink-500 resize-none"></textarea>
            </div>

            <button type="submit" id="btnSubmitMiniReel" class="w-full py-3 rounded-xl bg-gradient-to-r from-pink-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 text-white font-black text-xs uppercase tracking-wider transition shadow-lg shadow-pink-600/25">
                Publicar Mini Reel
            </button>
        </form>
    </div>
</div>

<!-- ================= JANELA / MODAL: VISUALIZADOR VERTICAL DE MINI REEL (COM REAÇÕES E COMENTÁRIOS RECURSIVOS) ================= -->
<div id="modalMiniReelViewer" class="hidden fixed inset-0 bg-black/90 backdrop-blur-md flex items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-white/15 rounded-3xl max-w-4xl w-full shadow-2xl overflow-hidden grid grid-cols-1 md:grid-cols-12 max-h-[90vh]">
        <!-- Card Vertical Estilo Mini Reel (7 colunas) -->
        <div id="reelViewerStage" class="md:col-span-7 relative min-h-[380px] sm:min-h-[520px] flex flex-col justify-between p-5 bg-gradient-to-br from-blue-700 via-indigo-800 to-purple-900 overflow-hidden">
            <!-- Imagem de fundo quando tipo === 'photo' -->
            <img id="reelViewerBgImg" src="" alt="Reel" class="hidden absolute inset-0 w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-black/60"></div>

            <!-- Topo do Mini Reel: Autor + Tempo Restante (6h ou 24h) + Excluir -->
            <div class="relative z-10 flex items-center justify-between gap-2">
                <div id="reelViewerAuthorBox" class="flex items-center gap-2.5"></div>
                <div class="flex items-center gap-2">
                    <span id="reelViewerDurationBadge" class="px-2.5 py-1 rounded-full bg-black/60 border border-white/15 text-[10px] font-bold text-amber-300 backdrop-blur-md"></span>
                    <button type="button" id="btnDeleteActiveReel" class="hidden w-8 h-8 rounded-full bg-red-600/80 hover:bg-red-600 text-white text-xs flex items-center justify-center transition" title="Excluir Mini Reel">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
            </div>

            <!-- Centro: Sentimento em Destaque (6h) + Texto / Legenda (24h) -->
            <div class="relative z-10 my-auto py-8 text-center space-y-3 px-4">
                <div id="reelViewerFeelingPill" class="hidden inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/25 border border-amber-400/50 text-amber-200 text-sm font-black shadow-xl backdrop-blur-md"></div>
                <p id="reelViewerTextContent" class="text-base sm:text-xl font-black text-white drop-shadow-lg whitespace-pre-line break-words leading-relaxed"></p>
            </div>

            <!-- Rodapé do Stage: Navegação Anterior / Próximo Mini Reel -->
            <div class="relative z-10 flex items-center justify-between pt-2">
                <button type="button" id="btnPrevMiniReel" class="px-3.5 py-1.5 rounded-xl bg-black/60 hover:bg-white/20 text-white text-xs font-bold backdrop-blur-md border border-white/10 transition">
                    <i class="fa-solid fa-chevron-left mr-1"></i> Anterior
                </button>
                <span id="reelViewerIndexCounter" class="text-[11px] font-bold text-zinc-300">1 / 1</span>
                <button type="button" id="btnNextMiniReel" class="px-3.5 py-1.5 rounded-xl bg-black/60 hover:bg-white/20 text-white text-xs font-bold backdrop-blur-md border border-white/10 transition">
                    Próximo <i class="fa-solid fa-chevron-right ml-1"></i>
                </button>
            </div>
        </div>

        <!-- Coluna Direita: Reações e Comentários Recursivos do Mini Reel (5 colunas) -->
        <div class="md:col-span-5 flex flex-col max-h-[85vh] bg-slate-900 border-l border-white/10">
            <div class="p-4 border-b border-white/10 flex items-center justify-between">
                <h5 class="text-xs font-black uppercase tracking-wider text-zinc-300 flex items-center gap-2">
                    <i class="fa-solid fa-heart text-pink-400"></i>
                    Reações & Comentários
                </h5>
                <button type="button" class="btn-close-modal w-8 h-8 rounded-full bg-slate-800 hover:bg-red-600 text-zinc-300 hover:text-white flex items-center justify-center text-lg transition">&times;</button>
            </div>

            <div class="px-4 py-3 border-b border-white/10 bg-slate-950/60">
                <div id="reelViewerReactionBar" class="flex flex-wrap items-center justify-between gap-2"></div>
            </div>

            <div id="reelViewerCommentsList" class="flex-1 overflow-y-auto p-4 space-y-2.5"></div>

            <form id="formCommentMiniReel" class="p-3.5 border-t border-white/10 bg-slate-950 flex items-center gap-2">
                <input type="hidden" id="activeMiniReelViewerId" value="">
                <input type="text" id="inputCommentMiniReelText" placeholder="Comentar neste Mini Reel..."
