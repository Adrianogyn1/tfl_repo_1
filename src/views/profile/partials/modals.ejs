                <i class="fa-solid fa-users text-sky-400"></i>
                Criar Novo Grupo de Chat
            </h4>
            <button class="btn-close-modal text-zinc-400 hover:text-white text-xl">&times;</button>
        </div>

        <form id="formCreateGroupChat" class="space-y-4 text-xs">
            <div>
                <label class="block font-bold text-zinc-400 uppercase mb-2">Nome do Grupo</label>
                <input type="text" id="inputNewGroupName" required placeholder="Ex: Clã dos Dragões, Festa VIP..."
                       class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-xs text-white focus:outline-none focus:border-sky-500">
            </div>

            <div>
                <label class="block font-bold text-zinc-400 uppercase mb-2">Selecionar Amigos para o Grupo</label>
                <div class="max-h-48 overflow-y-auto space-y-2 p-3 rounded-2xl bg-slate-950 border border-white/5">
                    <% if (friendsData?.friendsList && friendsData.friendsList.length > 0) { %>
                        <% friendsData.friendsList.forEach(function(item) { %>
                            <label class="flex items-center justify-between p-2 rounded-xl hover:bg-slate-900 cursor-pointer transition">
                                <div class="flex items-center gap-2.5">
                                    <img src="<%= item.avatar?.thumbnail || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(item.avatar?.name || 'Avatar') + '&background=0284c7&color=fff' %>"
                                         class="w-8 h-8 rounded-lg object-cover">
                                    <span class="font-bold text-white"><%= item.avatar?.name %></span>
                                </div>
                                <input type="checkbox" class="chk-group-member w-4 h-4 accent-sky-500 rounded" value="<%= item.avatar?.id %>">
                            </label>
                        <% }); %>
                    <% } else { %>
                        <p class="text-zinc-500 text-center py-3">Adicione amigos primeiro para incluí-los em grupos.</p>
                    <% } %>
                </div>
            </div>

            <button type="submit" class="w-full py-3.5 bg-sky-600 hover:bg-sky-500 text-white rounded-xl text-xs font-black uppercase tracking-wider transition shadow-lg shadow-sky-600/30">
                Criar Grupo e Abrir Chat
            </button>
        </form>
    </div>
</div>

