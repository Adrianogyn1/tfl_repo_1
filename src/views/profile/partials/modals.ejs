<!-- ================= JANELA / MODAL: CRIAR SALA ================= -->
<div id="modalCreateRoom" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-white/10 p-6 sm:p-8 rounded-3xl max-w-md w-full shadow-2xl space-y-5">
        <div class="flex justify-between items-center border-b border-white/5 pb-3">
            <h4 class="text-sm font-black uppercase italic text-white flex items-center gap-2">
                <i class="fa-solid fa-house-medical text-emerald-400"></i>
                Criar Nova Sala
            </h4>
            <button class="btn-close-modal text-zinc-400 hover:text-white text-xl">&times;</button>
        </div>

        <form id="formCreateRoom" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-zinc-400 uppercase mb-2">Nome do Espaço</label>
                <div class="flex gap-2">
                    <input type="text" id="newRoomName" required placeholder="Ex: Mansão Celestial"
                           class="flex-1 bg-slate-950 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-blue-500">
                    <button type="button" id="btnRollRoomName" class="px-3.5 bg-slate-800 hover:bg-blue-600 text-white rounded-xl text-sm transition hover:rotate-180 duration-300" title="Gerar Nome Aleatório da Sala">
                        <i class="fa-solid fa-dice text-base"></i>
                    </button>
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold text-zinc-400 uppercase mb-2">Descrição</label>
                <textarea id="newRoomDesc" rows="2" placeholder="Descreva este ambiente..."
                          class="w-full bg-slate-950 border border-white/10 rounded-xl px-3.5 py-2 text-xs text-white focus:outline-none focus:border-blue-500 resize-none"></textarea>
            </div>
            
            <div class="grid grid-cols-2 gap-4 items-center">
                <div>
                    <label class="block text-xs font-bold text-zinc-400 uppercase mb-2">Máximo Jogadores</label>
                    <input type="number" id="newRoomMax" value="30" min="1" max="100"
                           class="w-full bg-slate-950 border border-white/10 rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-zinc-400 uppercase mb-2">Privacidade</label>
                    <div class="flex items-center gap-3 py-1">
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="toggleNewRoomPrivate" class="sr-only peer">
                            <div class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                        </label>
                        <span id="labelNewRoomPrivate" class="text-xs font-bold text-zinc-400">Pública 🌐</span>
                    </div>
                </div>
            </div>

            <!-- Cobrança de Entrada (Passe 24h) -->
            <div class="p-3.5 rounded-2xl bg-slate-950/90 border border-amber-500/20 space-y-2.5"
                 data-room-fee-percent="<%= Number(marketStats?.roomEntryPlatformFeePercent ?? 15) %>"
                 data-room-pass-hours="<%= Number(marketStats?.roomPassDurationHours ?? 24) %>"
                 data-room-payout-1k="<%= Number(marketStats?.roomVisitsPayoutPer1kCoins ?? 50) %>">
                <div class="flex items-center justify-between gap-2">
                    <label for="newRoomEntryValue" class="text-[11px] font-black text-amber-400 uppercase flex items-center gap-1.5">
                        <i class="fa-solid fa-ticket"></i> Cobrar Entrada (Passe <%= Number(marketStats?.roomPassDurationHours ?? 24) %>h em Coins)
                    </label>
                    <span class="text-[10px] font-bold text-zinc-500">0 = Entrada Grátis</span>
                </div>
                <div class="relative">
                    <input type="number" id="newRoomEntryValue" value="0" min="0" step="0.01" placeholder="0.00"
                           class="w-full bg-slate-900 border border-white/10 rounded-xl pl-3.5 pr-16 py-2 text-xs font-bold text-white focus:outline-none focus:border-amber-500">
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[10px] font-black text-amber-400 uppercase">Coins</span>
                </div>
                <div id="newRoomFeePreview" class="grid grid-cols-3 gap-2 pt-1 text-[10px] border-t border-white/5">
                    <div>
                        <span class="text-zinc-500 block">Passe (<%= Number(marketStats?.roomPassDurationHours ?? 24) %>h)</span>
                        <span id="newRoomGrossDisplay" class="font-bold text-white">Grátis</span>
                    </div>
                    <div>
                        <span class="text-zinc-500 block">Taxa (<%= Number(marketStats?.roomEntryPlatformFeePercent ?? 15).toLocaleString('pt-BR') %>%)</span>
                        <span id="newRoomFeeDisplay" class="font-bold text-rose-400">0,00 Coins</span>
                    </div>
                    <div>
                        <span class="text-zinc-500 block">Você Recebe</span>
                        <span id="newRoomNetDisplay" class="font-black text-emerald-400">0,00 Coins</span>
                    </div>
                </div>
                <p class="text-[10px] text-zinc-400 leading-relaxed">
                    <i class="fa-solid fa-trophy text-emerald-400 mr-1"></i>
                    Além do passe, sua sala ganha <strong class="text-emerald-400">+<%= Number(marketStats?.roomVisitsPayoutPer1kCoins ?? 50).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %> Coins</strong> automaticamente a cada <strong class="text-white">1.000 visitas únicas no mês</strong>!
                </p>
            </div>

            <button type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold uppercase tracking-wider transition shadow-lg shadow-emerald-600/30">
                Criar Sala
            </button>
        </form>
    </div>
</div>

