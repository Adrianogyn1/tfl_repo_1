                    <input type="number" id="inspectRoomEntryValue" value="0" min="0" step="0.01" placeholder="0.00"
                           class="w-full bg-slate-900 border border-white/10 rounded-xl pl-3.5 pr-16 py-2 text-xs font-bold text-white focus:outline-none focus:border-amber-500">
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[10px] font-black text-amber-400 uppercase">Coins</span>
                </div>
                <div class="grid grid-cols-3 gap-2 pt-1 text-[10px] border-t border-white/5">
                    <div>
                        <span class="text-zinc-500 block">Valor do Passe (<%= Number(marketStats?.roomPassDurationHours ?? 24) %>h)</span>
                        <span id="inspectRoomGrossDisplay" class="font-bold text-white">Grátis</span>
                    </div>
                    <div>
                        <span class="text-zinc-500 block">Taxa (<%= Number(marketStats?.roomEntryPlatformFeePercent ?? 15).toLocaleString('pt-BR') %>%)</span>
                        <span id="inspectRoomFeeDisplay" class="font-bold text-rose-400">0,00 Coins</span>
                    </div>
                    <div>
                        <span class="text-zinc-500 block">Repasse p/ Você</span>
                        <span id="inspectRoomNetDisplay" class="font-black text-emerald-400">0,00 Coins</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
                <div>
                    <label class="block text-xs font-bold text-zinc-400 uppercase mb-2">Privacidade</label>
                    <div class="flex items-center gap-3 py-1">
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="toggleInspectRoomPrivate" class="sr-only peer">
                            <div class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                        </label>
                        <span id="labelInspectRoomPrivate" class="text-xs font-bold text-zinc-400">Pública 🌐</span>
                    </div>
                </div>
                <div id="containerInspectRoomPassword">
                    <label class="block text-xs font-bold text-zinc-400 uppercase mb-2">Senha da Sala</label>
                    <input type="text" id="inspectRoomPassword" placeholder="Definir senha de acesso"
                           class="w-full bg-slate-950 border border-white/10 rounded-xl px-3.5 py-2 text-xs text-white focus:outline-none focus:border-blue-500">
                </div>
            </div>

            <div class="flex justify-end pt-2">
                <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-xs font-bold uppercase tracking-wider transition shadow-lg shadow-blue-600/30">
                    Salvar Dados da Sala
                </button>
            </div>
        </form>

        <!-- O que tem no item: Objetos e Estrutura da Sala -->
        <div class="pt-4 border-t border-white/10 space-y-3">
            <h5 class="text-xs font-black uppercase italic text-zinc-300 flex items-center gap-2">
                <i class="fa-solid fa-cube text-yellow-500"></i>
                Objetos Instalados nesta Sala
            </h5>
            <div id="roomObjectsContainer" class="p-4 rounded-2xl bg-slate-950 border border-white/5 min-h-[100px] flex flex-col justify-center text-center text-xs text-zinc-500">
                <span>Carregando objetos da sala...</span>
            </div>
        </div>
    </div>
</div>

<!-- ================= JANELA / MODAL: COMPRA DE CASH VIA PIX (MÍNIMO R$ 10,00 ASAAS) ================= -->
<div id="modalDepositPix" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-white/10 p-6 sm:p-8 rounded-3xl max-w-md w-full shadow-2xl space-y-6">
        <div class="flex justify-between items-center border-b border-white/5 pb-3">
            <h4 class="text-sm font-black uppercase italic text-white flex items-center gap-2">
                <i class="fa-brands fa-pix text-emerald-400 text-lg"></i>
                Comprar Cash via Pix (Asaas)
            </h4>
            <button class="btn-close-modal text-zinc-400 hover:text-white text-xl">&times;</button>
        </div>

        <div id="depositFormStep" class="space-y-4">
            <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-[11px] text-amber-300 leading-relaxed">
                <i class="fa-solid fa-circle-info mr-1"></i>
                Valor mínimo para processar Pix dinâmico no Asaas: <strong>R$ <%= Number(marketStats?.minPurchaseBrl || 10).toFixed(2) %></strong>
                (equivalente a <strong><%= (Number(marketStats?.minPurchaseBrl || 10) / Number(marketStats?.usdBrlRate || 5)).toFixed(2) %> Cash</strong>).
            </div>

            <div>
                <label class="block text-xs font-bold text-zinc-400 uppercase mb-2">Quantidade de Cash Desejada</label>
                <div class="relative">
                    <input type="number" id="inputDepositCash"
                           min="<%= (Number(marketStats?.minPurchaseBrl || 10) / Number(marketStats?.usdBrlRate || 5)).toFixed(2) %>"
                           step="any" value="2" placeholder="Mínimo 2 Cash (R$ 10,00)..."
                           class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-sm font-bold text-white focus:outline-none focus:border-emerald-500">
                    <span class="absolute right-4 top-3 text-xs text-zinc-500 font-bold">$ Cash</span>
                </div>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-950 border border-white/5 space-y-1.5 text-xs">
                <div class="flex justify-between items-center">
                    <span class="text-zinc-400">Total a pagar em Reais:</span>
                    <span id="labelDepositBrlTotal" class="font-black text-emerald-400 text-sm">R$ 10,00</span>
                </div>
                <div class="flex justify-between items-center text-[11px]">
                    <span class="text-zinc-500">Regra de liberação:</span>
                    <span id="labelDepositApprovalPreview" class="font-bold text-emerald-400">Automática</span>
                </div>
            </div>

            <button type="button" id="btnGeneratePixDeposit" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-black uppercase tracking-wider transition shadow-lg shadow-emerald-600/30 flex items-center justify-center gap-2">
                <i class="fa-brands fa-pix text-base"></i>
                Gerar QR Code Pix Dinâmico
            </button>
        </div>

        <!-- Passo 2: QR Code e Código Copia e Cola -->
        <div id="depositResultStep" class="hidden space-y-4 text-center">
            <div id="qrCodeImgContainer" class="p-4 bg-white rounded-2xl inline-block mx-auto shadow-inner">
                <!-- Imagem do QR Code inserida dinamicamente -->
            </div>

            <div class="text-left space-y-1.5">
                <label class="block text-[11px] font-bold text-zinc-400 uppercase">Código Pix (Copia e Cola):</label>
                <div class="flex gap-2">
                    <input type="text" id="inputPixCopyPaste" readonly
                           class="flex-1 bg-slate-950 border border-white/10 rounded-xl px-3 py-2 text-xs text-zinc-300 font-mono">
                    <button type="button" id="btnCopyPix" class="px-3.5 py-2 bg-slate-800 hover:bg-blue-600 text-white rounded-xl text-xs font-bold transition">
                        Copiar
                    </button>
                </div>
            </div>

            <div class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-400 space-y-1">
                <p class="font-bold">Aguardando confirmação do Pix...</p>
                <p class="text-[11px] text-zinc-400">Assim que confirmado pelo Asaas, o sistema aplicará a regra de aprovação configurada.</p>
            </div>

            <input type="hidden" id="currentDepositPaymentId">

            <!-- Botão de simular confirmação em ambiente de teste/localhost -->
            <button type="button" id="btnSimulatePixPayment" class="w-full py-2.5 bg-slate-800 hover:bg-emerald-700 text-zinc-300 hover:text-white rounded-xl text-xs font-bold uppercase tracking-wider transition">
                <i class="fa-solid fa-bolt mr-1 text-yellow-400"></i>
                Simular Confirmação Pix (Modo Teste)
            </button>
        </div>
    </div>
</div>

<!-- ================= JANELA / MODAL: SAQUE DE CASH VIA PIX (MÍNIMO 1 CASH) ================= -->
<div id="modalWithdrawPix" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-white/10 p-6 sm:p-8 rounded-3xl max-w-md w-full shadow-2xl space-y-5">
        <div class="flex justify-between items-center border-b border-white/5 pb-3">
            <h4 class="text-sm font-black uppercase italic text-white flex items-center gap-2">
                <i class="fa-solid fa-money-bill-transfer text-blue-400 text-lg"></i>
                Solicitar Saque de Cash (Pix)
            </h4>
            <button class="btn-close-modal text-zinc-400 hover:text-white text-xl">&times;</button>
        </div>

        <form id="formWithdrawPix" class="space-y-4">
            <div class="p-3 rounded-xl bg-blue-500/10 border border-blue-500/20 text-[11px] text-blue-300 leading-relaxed">
                Valor mínimo para saque: <strong>$<%= Number(marketStats?.minWithdrawCash || 1).toFixed(2) %> Cash</strong>
                (R$ <%= (Number(marketStats?.minWithdrawCash || 1) * Number(marketStats?.usdBrlRate || 5)).toFixed(2) %>).
                Seu saldo disponível: <strong>$<%= Number(wallet?.cash || 0).toFixed(2) %> Cash</strong>.
            </div>

            <div>
                <div class="flex justify-between items-center mb-2">
                    <label class="text-xs font-bold text-zinc-400 uppercase">Quantidade de Cash para Saque</label>
                    <button type="button" id="btnMaxWithdrawCash" class="text-[10px] font-bold text-blue-400 hover:underline">
                        Sacar Tudo ($<%= Number(wallet?.cash || 0).toFixed(2) %>)
                    </button>
                </div>
                <div class="relative">
                    <input type="number" id="inputWithdrawCash"
                           min="<%= Number(marketStats?.minWithdrawCash || 1) %>"
                           step="any" value="<%= Math.max(Number(marketStats?.minWithdrawCash || 1), 1) %>" required
                           class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-sm font-bold text-white focus:outline-none focus:border-blue-500">
                    <span class="absolute right-4 top-3 text-xs text-zinc-500 font-bold">$ Cash</span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-bold text-zinc-400 uppercase mb-2">Tipo Chave</label>
                    <select id="inputWithdrawPixType" class="w-full bg-slate-950 border border-white/10 rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none">
                        <option value="CPF">CPF</option>
                        <option value="EMAIL">E-mail</option>
                        <option value="PHONE">Celular</option>
                        <option value="EVP">Aleatória</option>
                        <option value="CNPJ">CNPJ</option>
                    </select>
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-xs font-bold text-zinc-400 uppercase mb-2">Sua Chave Pix</label>
                    <input type="text" id="inputWithdrawPixKey" required value="<%= wallet?.pixKey || '' %>"
                           placeholder="Digite sua chave Pix..."
                           class="w-full bg-slate-950 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-blue-500">
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-amber-400 uppercase mb-1.5 flex items-center gap-1.5">
                    <i class="fa-solid fa-lock text-xs"></i> PIN de Segurança da Carteira (4 dígitos)
                </label>
                <input type="password" id="inputWithdrawWalletPin" maxlength="4" pattern="[0-9]{4}"
                       placeholder="••••"
                       class="w-full bg-slate-950 border border-amber-500/30 rounded-xl px-4 py-2.5 text-xs text-white font-mono tracking-widest text-center focus:outline-none focus:border-amber-400">
                <span class="text-[10px] text-zinc-500 block mt-1">Obrigatório caso tenha cadastrado um PIN na sua conta.</span>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-950 border border-white/5 space-y-1.5 text-xs">
                <div class="flex justify-between items-center">
                    <span class="text-zinc-400">Valor a receber no Pix:</span>
                    <span id="labelWithdrawBrlTotal" class="font-black text-emerald-400 text-sm">R$ 5,00</span>
                </div>
                <div class="flex justify-between items-center text-[11px]">
                    <span class="text-zinc-500">Processamento previsto:</span>
                    <span id="labelWithdrawApprovalPreview" class="font-bold text-emerald-400">Aprovação Automática</span>
                </div>
            </div>

            <button type="submit" id="btnSubmitWithdraw" class="w-full py-3.5 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-xs font-black uppercase tracking-wider transition shadow-lg shadow-blue-600/30 flex items-center justify-center gap-2">
                <i class="fa-solid fa-paper-plane"></i>
                Confirmar Solicitação de Saque
            </button>
        </form>
    </div>
</div>

<!-- ================= JANELA / MODAL: TABELA DE REGRAS ECONÔMICAS & APROVAÇÃO (ADMIN) ================= -->
<div id="modalEconomyRules" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-slate-900 border border-white/10 p-6 sm:p-8 rounded-3xl max-w-xl w-full shadow-2xl space-y-5 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center border-b border-white/5 pb-3">
            <div>
                <h4 class="text-sm font-black uppercase italic text-white flex items-center gap-2">
                    <i class="fa-solid fa-sliders text-amber-400"></i>
                    Tabela de Regras, Spread & Aprovação (economy_rules)
                </h4>
                <p class="text-[11px] text-zinc-400">Configure as taxas do mercado e se compras/saques aprovam no automático ou manual.</p>
            </div>
            <button class="btn-close-modal text-zinc-400 hover:text-white text-xl">&times;</button>
        </div>

        <form id="formEconomyRules" class="space-y-4 text-xs">
            <!-- Taxas de Spread do Mercado -->
            <div class="p-4 rounded-2xl bg-slate-950/70 border border-white/5 space-y-3">
                <h5 class="font-black uppercase text-amber-400 tracking-wider text-[11px]">Taxas de Spread (Bolsa de Coins)</h5>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-zinc-400 font-bold mb-1">Taxa de Venda (%)</label>
                        <input type="number" step="0.01" min="0" id="ruleSellSpread" value="<%= Number(marketStats?.sellSpreadPercent ?? 0.5) %>"
                               class="w-full bg-slate-900 border border-white/10 rounded-xl px-3 py-2 text-white font-bold">
                    </div>
                    <div>
                        <label class="block text-zinc-400 font-bold mb-1">Taxa de Compra (%)</label>
                        <input type="number" step="0.01" min="0" id="ruleBuySpread" value="<%= Number(marketStats?.buySpreadPercent ?? 0.1) %>"
                               class="w-full bg-slate-900 border border-white/10 rounded-xl px-3 py-2 text-white font-bold">
                    </div>
                </div>
                <div class="text-[11px] text-zinc-500 flex justify-between pt-1">
                    <span>Total já arrecadado pelo sistema em taxas de spread:</span>
                    <strong class="text-emerald-400">$<%= Number(marketStats?.collectedFeesCash || 0).toFixed(4) %> Cash</strong>
                </div>
            </div>

            <!-- Limites Mínimos -->
            <div class="p-4 rounded-2xl bg-slate-950/70 border border-white/5 space-y-3">
                <h5 class="font-black uppercase text-emerald-400 tracking-wider text-[11px]">Valores Mínimos (Compra Asaas & Saque)</h5>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-zinc-400 font-bold mb-1">Mínimo para Compra Pix (R$)</label>
                        <input type="number" step="0.50" min="1" id="ruleMinPurchaseBrl" value="<%= Number(marketStats?.minPurchaseBrl || 10).toFixed(2) %>"
                               class="w-full bg-slate-900 border border-white/10 rounded-xl px-3 py-2 text-white font-bold">
                    </div>
                    <div>
                        <label class="block text-zinc-400 font-bold mb-1">Mínimo para Saque ($ Cash)</label>
                        <input type="number" step="0.50" min="0.1" id="ruleMinWithdrawCash" value="<%= Number(marketStats?.minWithdrawCash || 1).toFixed(2) %>"
                               class="w-full bg-slate-900 border border-white/10 rounded-xl px-3 py-2 text-white font-bold">
                    </div>
                </div>
            </div>

            <!-- Regras de Aprovação (Automático vs Manual + Teto Máximo) -->
            <div class="p-4 rounded-2xl bg-slate-950/70 border border-white/5 space-y-3">
                <h5 class="font-black uppercase text-blue-400 tracking-wider text-[11px]">Aprovação de Saques e Compras (Auto vs Manual)</h5>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-zinc-400 font-bold mb-1">Modo de Aprovação de Saque</label>
                        <select id="ruleWithdrawMode" class="w-full bg-slate-900 border border-white/10 rounded-xl px-3 py-2 text-white font-bold">
                            <option value="AUTO" <%= marketStats?.withdrawApprovalMode === 'AUTO' ? 'selected' : '' %>>Automático (até o limite)</option>
                            <option value="MANUAL" <%= marketStats?.withdrawApprovalMode === 'MANUAL' ? 'selected' : '' %>>Sempre Manual (Painel Admin)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-zinc-400 font-bold mb-1">Valor Máx. Saque Automático ($ Cash)</label>
                        <input type="number" step="1" min="0" id="ruleMaxAutoWithdrawCash" value="<%= Number(marketStats?.maxAutoWithdrawCash || 20).toFixed(2) %>"
                               class="w-full bg-slate-900 border border-white/10 rounded-xl px-3 py-2 text-white font-bold">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-white/5">
                    <div>
                        <label class="block text-zinc-400 font-bold mb-1">Modo de Aprovação de Compra</label>
                        <select id="ruleBuyMode" class="w-full bg-slate-900 border border-white/10 rounded-xl px-3 py-2 text-white font-bold">
                            <option value="AUTO" <%= marketStats?.buyApprovalMode === 'AUTO' ? 'selected' : '' %>>Automático (até o limite)</option>
                            <option value="MANUAL" <%= marketStats?.buyApprovalMode === 'MANUAL' ? 'selected' : '' %>>Sempre Manual (Painel Admin)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-zinc-400 font-bold mb-1">Valor Máx. Compra Automática (R$)</label>
                        <input type="number" step="10" min="0" id="ruleMaxAutoBuyBrl" value="<%= Number(marketStats?.maxAutoBuyBrl || 500).toFixed(2) %>"
                               class="w-full bg-slate-900 border border-white/10 rounded-xl px-3 py-2 text-white font-bold">
                    </div>
                </div>
            </div>

            <!-- Regras do Conversor Direto (Desincentivo Coins -> Cash) -->
            <div class="p-4 rounded-2xl bg-slate-950/70 border border-white/5 space-y-3">
                <h5 class="font-black uppercase text-red-400 tracking-wider text-[11px]">Conversor Direto Coins ➔ Cash (Proteção da Bolsa)</h5>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-zinc-400 font-bold mb-1">Conversão Direta Coins ➔ Cash</label>
                        <select id="ruleAllowInstantCoinsToCash" class="w-full bg-slate-900 border border-white/10 rounded-xl px-3 py-2 text-white font-bold">
                            <option value="true" <%= marketStats?.allowInstantCoinsToCash !== false ? 'selected' : '' %>>Permitir com Taxa Punitiva</option>
                            <option value="false" <%= marketStats?.allowInstantCoinsToCash === false ? 'selected' : '' %>>Bloquear (Somente via Bolsa)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-zinc-400 font-bold mb-1">Taxa de Perda Coins ➔ Cash (%)</label>
                        <input type="number" step="1" min="0" max="99" id="ruleInstantCoinsToCashFee" value="<%= Number(marketStats?.instantCoinsToCashFeePercent ?? 30) %>"
                               class="w-full bg-slate-900 border border-white/10 rounded-xl px-3 py-2 text-white font-bold">
                    </div>
                </div>
            </div>

            <button type="submit" class="w-full py-3.5 bg-amber-600 hover:bg-amber-500 text-white rounded-xl text-xs font-black uppercase tracking-wider transition shadow-lg shadow-amber-600/30">
                Salvar Regras na Tabela (economy_rules)
            </button>
        </form>
    </div>
</div>
