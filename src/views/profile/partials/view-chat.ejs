<!-- ================= SISTEMA DE CHAT FLUTUANTE ESTILO WHATSAPP + BAG DE NOTIFICAÇÕES ================= -->
<%
    const isChatVip = Boolean(vipStatus?.isVip || activeAvatar?.isVip);
    const cDmUsed = Number(vipStatus?.usageToday?.dmOpens || 0);
    const cImgUsed = Number(vipStatus?.usageToday?.imagesSent || 0);
    const cAudUsed = Number(vipStatus?.usageToday?.audioSent || 0);
    const cMaxDm = Number(marketStats?.basicMaxChatOpensPerDay ?? 3);
    const cMaxImg = Number(marketStats?.basicMaxChatImagesPerDay ?? 2);
    const cMaxAud = Number(marketStats?.basicMaxChatAudioPerDay ?? 2);
    const bagUnreadCount = Number(notificationsData?.unreadCount || 0);
    const bagNotifItems = Array.isArray(notificationsData?.notifications) ? notificationsData.notifications : [];
%>

<!-- 1. BALÃO FLUTUANTE ARRASTÁVEL (O USUÁRIO POSICIONA ONDE ACHAR MELHOR) -->
<div id="tflFloatingChatBubble"
     class="fixed bottom-6 right-6 z-50 select-none touch-none cursor-grab active:cursor-grabbing group"
     title="Arraste para posicionar onde preferir • Clique para abrir/fechar o Chat & Bag">
    <div class="relative flex items-center">
        <!-- Botão Secundário acoplado: Bag de Notificações com Contador -->
        <button type="button" id="btnFloatingBubbleOpenBag"
                class="-mr-2 z-10 w-10 h-10 rounded-full bg-slate-900 hover:bg-amber-500 text-amber-400 hover:text-slate-950 border-2 border-amber-500/50 shadow-xl flex items-center justify-center transition transform hover:scale-105"
                title="Bag de Notificações">
            <i class="fa-solid fa-bag-shopping text-sm"></i>
            <span id="floatingBagUnreadBadge"
                  class="<%= bagUnreadCount > 0 ? '' : 'hidden' %> absolute -top-1.5 -left-1.5 min-w-[18px] h-[18px] px-1 rounded-full bg-amber-500 text-slate-950 text-[10px] font-black flex items-center justify-center shadow">
                <%= bagUnreadCount %>
            </span>
        </button>

        <!-- Balão Principal Estilo WhatsApp -->
        <button type="button" id="btnFloatingBubbleToggleChat"
                class="relative w-14 h-14 rounded-full bg-gradient-to-tr from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white shadow-2xl shadow-emerald-600/40 border-2 border-white/20 flex items-center justify-center transition transform group-hover:scale-105">
            <i id="floatingBubbleMainIcon" class="fa-brands fa-whatsapp text-2xl"></i>
            <!-- Contador de Mensagens Não Lidas no Balão -->
            <span id="floatingChatUnreadBadge"
                  class="hidden absolute -top-1 -right-1 min-w-[20px] h-5 px-1.5 rounded-full bg-rose-500 text-white text-[10px] font-black flex items-center justify-center border-2 border-slate-950 shadow-lg animate-bounce">
                0
            </span>
        </button>
    </div>
</div>

<!-- 2. JANELA FLUTUANTE ESTILO WHATSAPP (ABRE E FECHA SEM ATRAPALHAR A NAVEGAÇÃO) -->
<aside id="tflWhatsappChatWindow"
       class="hidden fixed bottom-24 right-6 z-50 w-[370px] sm:w-[410px] h-[560px] max-h-[80vh] max-w-[94vw] bg-[#0b141a] border border-emerald-500/30 rounded-3xl shadow-2xl flex flex-col overflow-hidden backdrop-blur-2xl">

    <!-- Topo WhatsApp: Abas Conversas & Bag de Notificações + Controles -->
    <div id="tflWhatsappWindowHeader" class="px-3.5 py-2.5 bg-[#111b21] border-b border-white/10 flex items-center justify-between gap-2 select-none">
        <div class="flex items-center gap-1.5">
            <!-- Aba 1: Conversas WhatsApp -->
            <button type="button" id="btnFloatingTabChats"
                    class="px-3 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider bg-emerald-600 text-white flex items-center gap-1.5 transition">
                <i class="fa-brands fa-whatsapp text-sm"></i>
                <span>Conversas</span>
                <span id="floatingChatTabUnreadBadge" class="hidden px-1.5 py-0.2 rounded-full bg-white text-emerald-950 text-[10px] font-black">0</span>
            </button>

            <!-- Aba 2: Bag de Notificações -->
            <button type="button" id="btnFloatingTabBag"
                    class="px-3 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider bg-slate-800/80 hover:bg-slate-800 text-zinc-300 flex items-center gap-1.5 transition">
                <i class="fa-solid fa-bag-shopping text-amber-400"></i>
                <span>Bag</span>
                <span id="floatingChatTabBagBadge" class="<%= bagUnreadCount > 0 ? '' : 'hidden' %> px-1.5 py-0.2 rounded-full bg-amber-500 text-slate-950 text-[10px] font-black">
                    <%= bagUnreadCount %>
                </span>
            </button>
        </div>

        <div class="flex items-center gap-1.5">
            <span id="wsStatusDot" class="w-2 h-2 rounded-full bg-amber-400" title="Status Tempo Real"></span>
            <span id="wsStatusText" class="hidden text-[9px] text-zinc-400">...</span>

            <button type="button" id="btnOpenCreateGroupModal"
                    class="p-1.5 rounded-xl bg-slate-800 hover:bg-emerald-600 text-zinc-300 hover:text-white transition"
                    title="Criar Novo Grupo">
                <span class="material-symbols-outlined text-[17px]">group_add</span>
            </button>
            <button type="button" id="btnMinimizeFloatingChat"
                    class="p-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-zinc-300 hover:text-white transition"
                    title="Minimizar / Fechar janela">
                <span class="material-symbols-outlined text-[17px]">close_fullscreen</span>
            </button>
        </div>
    </div>

    <!-- CONTEÚDO ABA 1: CONVERSAS ESTILO WHATSAPP -->
    <div id="floatingChatTabContent" class="flex-1 flex flex-col overflow-hidden">

        <!-- TELA 1: LISTA DE CONVERSAS -->
        <div id="chatListScreen" class="flex-1 flex flex-col bg-[#0b141a] h-full overflow-hidden">
            <!-- Filtros compactos estilo WhatsApp -->
            <div class="px-3 py-2 border-b border-white/5 bg-[#111b21]/70 flex items-center gap-1.5 overflow-x-auto">
                <button type="button" class="btn-chat-list-filter px-2.5 py-1 rounded-lg text-[10px] font-black uppercase bg-emerald-600 text-white transition" data-filter="all">
                    Todas
                </button>
                <button type="button" class="btn-chat-list-filter px-2.5 py-1 rounded-lg text-[10px] font-black uppercase bg-slate-900 text-zinc-400 hover:text-white transition" data-filter="private">
                    DMs
                </button>
                <button type="button" class="btn-chat-list-filter px-2.5 py-1 rounded-lg text-[10px] font-black uppercase bg-slate-900 text-zinc-400 hover:text-white transition" data-filter="group">
                    Grupos
                </button>
                <button type="button" class="btn-chat-list-filter px-2.5 py-1 rounded-lg text-[10px] font-black uppercase bg-slate-900 text-zinc-400 hover:text-white transition" data-filter="global">
                    Global
                </button>
            </div>

            <!-- Lista de Conversas (Paginada 20 itens) -->
            <div id="chatRoomsListContainer" class="flex-1 overflow-y-auto p-2.5 space-y-1.5">
                <div class="p-8 text-center text-xs text-zinc-500">
                    <i class="fa-solid fa-spinner fa-spin text-emerald-400 text-lg"></i>
                </div>
            </div>
        </div>

        <!-- TELA 2: CONVERSA ATIVA (ESTILO WHATSAPP) -->
        <div id="chatConversationScreen" class="hidden flex-1 flex flex-col bg-[#0b141a] h-full overflow-hidden">
            <!-- Cabeçalho da Conversa Ativa -->
            <div class="px-3 py-2 border-b border-white/10 bg-[#1f2c34] flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 overflow-hidden">
                    <button type="button" id="btnBackToChatList" class="p-1.5 rounded-xl bg-slate-900/70 hover:bg-slate-800 text-zinc-200 hover:text-white transition flex-shrink-0" title="Voltar para Conversas">
                        <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                    </button>

                    <button type="button" id="btnChatHeaderAction" class="flex items-center gap-2 overflow-hidden text-left group">
                        <div id="chatActiveAvatarBox" class="w-8 h-8 rounded-full bg-emerald-600/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 font-black flex-shrink-0 overflow-hidden">
                            <span class="material-symbols-outlined text-[16px]">public</span>
                        </div>
                        <div class="overflow-hidden">
                            <h4 id="chatActiveHeaderTitle" class="text-xs font-black text-white group-hover:text-emerald-400 transition truncate">Chat</h4>
                            <p id="chatActiveHeaderSub" class="text-[10px] text-zinc-400 truncate"></p>
                        </div>
                    </button>
                </div>

                <div class="flex items-center gap-1 flex-shrink-0">
                    <div id="chatTypingIndicator" class="hidden text-[10px] font-semibold text-emerald-400 italic animate-pulse mr-1">digitando...</div>

                    <button type="button" id="btnChatHeaderMiniProfile" class="hidden p-1.5 rounded-lg bg-slate-900/80 hover:bg-emerald-600 text-zinc-300 hover:text-white transition items-center justify-center" title="Mini Profile">
                        <span class="material-symbols-outlined text-[16px]">badge</span>
                    </button>
                    <button type="button" id="btnChatHeaderFullProfile" class="hidden p-1.5 rounded-lg bg-blue-600/20 hover:bg-blue-600 text-blue-400 hover:text-white transition items-center justify-center" title="Perfil">
                        <span class="material-symbols-outlined text-[16px]">person</span>
                    </button>
                    <button type="button" id="btnOpenGroupParticipants" class="hidden px-2 py-1 rounded-lg bg-purple-600/20 hover:bg-purple-600 text-purple-300 hover:text-white text-[10px] font-bold transition items-center gap-1" title="Membros">
                        <span class="material-symbols-outlined text-[14px]">groups</span>
                        <span id="labelGroupParticipantsBtn" class="hidden">Membros</span>
                    </button>
                    <button type="button" id="btnOpenGroupAddFriends" class="hidden p-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white transition items-center justify-center" title="Adicionar">
                        <span class="material-symbols-outlined text-[16px]">person_add</span>
                    </button>
                </div>
            </div>

            <!-- Faixa Compacta de Cota VIP -->
            <div id="chatVipQuotaBanner" class="px-3 py-1 border-b border-white/5 bg-[#111b21] flex items-center justify-between gap-2 text-[10px]">
                <div class="truncate text-zinc-400">
                    <% if (isChatVip) { %>
                        <span class="text-amber-400 font-black">👑 VIP</span> • Voz &amp; Fotos ilimitados
                    <% } else { %>
                        DMs <strong id="lblChatQuotaDm" class="text-white"><%= cDmUsed %>/<%= cMaxDm %></strong> • 📷 <strong id="lblChatQuotaImg" class="text-white"><%= cImgUsed %>/<%= cMaxImg %></strong> • 🎤 <strong id="lblChatQuotaAud" class="text-white"><%= cAudUsed %>/<%= cMaxAud %></strong>
                    <% } %>
                </div>
                <% if (!isChatVip) { %>
                    <button type="button" class="nav-item text-amber-400 hover:underline font-black text-[10px] flex-shrink-0" data-view="view-vip">👑 VIP</button>
                <% } %>
            </div>

            <!-- Histórico de Mensagens (Fundo escuro estilo WhatsApp) -->
            <div id="chatMessagesContainer" class="flex-1 overflow-y-auto p-3 space-y-2.5 bg-[#0b141a]"></div>

            <!-- Barra de Gravação de Voz Ativa -->
            <div id="voiceRecordingBar" class="hidden px-3 py-2 border-t border-rose-500/30 bg-rose-950/60 flex items-center justify-between gap-2">
                <div class="flex items-center gap-1.5 text-[11px] font-bold text-rose-300">
                    <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
                    <span>Gravando... <strong id="voiceRecordingTimer">00:00</strong></span>
                </div>
                <div class="flex items-center gap-1.5">
                    <button type="button" id="btnCancelVoiceRecord" class="px-2.5 py-1 rounded-lg bg-slate-800 text-zinc-300 text-[10px] font-bold">Cancelar</button>
                    <button type="button" id="btnStopAndSendVoice" class="px-2.5 py-1 rounded-lg bg-emerald-600 text-white text-[10px] font-black uppercase">Enviar 🎤</button>
                </div>
            </div>

            <!-- Barra Inferior de Envio estilo WhatsApp -->
            <form id="formSendChatMessage" class="p-2 border-t border-white/10 bg-[#1f2c34] flex items-center gap-1.5">
                <input type="hidden" id="activeChatRoomUid" value="">
                <input type="file" id="fileChatMedia" class="hidden" accept="image/*,audio/*,video/*">
                <input type="file" id="fileChatImageOnly" class="hidden" accept="image/*">
                <input type="file" id="fileChatAudioOnly" class="hidden" accept="audio/*">

                <button type="button" id="btnAttachChatImage" class="p-2 rounded-full hover:bg-white/10 text-zinc-300 hover:text-sky-400 transition flex-shrink-0" title="Enviar Foto">
                    <span class="material-symbols-outlined text-[18px]">photo_camera</span>
                </button>
                <button type="button" id="btnRecordChatVoice" class="p-2 rounded-full hover:bg-white/10 text-zinc-300 hover:text-amber-400 transition flex-shrink-0" title="Gravar Voz">
                    <span class="material-symbols-outlined text-[18px]">mic</span>
                </button>
                <button type="button" id="btnShareRoomInChat" class="p-2 rounded-full hover:bg-white/10 text-indigo-300 hover:text-indigo-200 transition flex-shrink-0" title="Enviar Endereço de Sala 3D">
                    <span class="material-symbols-outlined text-[18px]">meeting_room</span>
                </button>
                <input type="text" id="inputChatMessageText" autocomplete="off" placeholder="Mensagem..."
                       class="flex-1 bg-[#2a3942] border border-white/5 rounded-full px-3.5 py-2 text-xs text-white placeholder-zinc-400 focus:outline-none focus:border-emerald-500">
                <button type="submit" id="btnSendChatMessage" class="w-9 h-9 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white flex items-center justify-center flex-shrink-0 shadow-md">
                    <span class="material-symbols-outlined text-[17px]">send</span>
                </button>
            </form>
        </div>
    </div>

    <!-- CONTEÚDO ABA 2: BAG DE NOTIFICAÇÕES COM CONTADOR -->
    <div id="floatingBagTabContent" class="hidden flex-1 flex flex-col bg-[#0b141a] overflow-hidden">
        <div class="px-3.5 py-2.5 border-b border-white/10 bg-[#111b21] flex items-center justify-between">
            <span class="text-[11px] font-black uppercase tracking-wider text-amber-400 flex items-center gap-1.5">
                <i class="fa-solid fa-bag-shopping"></i> Bag de Notificações
            </span>
            <button type="button" id="btnFloatingBagMarkRead" class="text-[10px] font-bold text-emerald-400 hover:underline">
                Marcar todas lidas
            </button>
        </div>

        <div id="floatingBagNotificationsList" class="flex-1 overflow-y-auto p-3 space-y-2">
            <% if (bagNotifItems.length === 0) { %>
                <div class="text-xs text-zinc-500 text-center py-10">Sua Bag de Notificações está vazia.</div>
            <% } else { %>
                <% bagNotifItems.slice(0, 20).forEach(function(n) { %>
                    <div class="p-3 rounded-2xl border <%= n.isRead ? 'bg-slate-900/50 border-white/5 text-zinc-400' : 'bg-amber-500/10 border-amber-500/30 text-zinc-100' %> text-xs space-y-1">
                        <div class="font-black text-white flex items-center justify-between gap-2">
                            <span><%= n.title %></span>
                            <% if (!n.isRead) { %><span class="w-2 h-2 rounded-full bg-amber-400"></span><% } %>
                        </div>
                        <p class="text-[11px] leading-snug text-zinc-300"><%= n.message %></p>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>
</aside>

<!-- ================= MODAL 1: ENDEREÇO DA SALA & INSTÂNCIA DO SERVIDOR NO CHAT ================= -->
<div id="modalShareRoomChat" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-indigo-500/30 rounded-3xl max-w-lg w-full p-5 sm:p-6 space-y-4 shadow-2xl max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center text-indigo-400">
                    <span class="material-symbols-outlined text-[20px]">dns</span>
                </div>
                <div>
                    <h4 class="text-sm font-black uppercase text-white">Compartilhar Endereço de Sala &amp; Servidor</h4>
                    <p class="text-[11px] text-zinc-400">Envie o IP/Porta e a Instância ativa para seus amigos entrarem direto</p>
                </div>
            </div>
            <button type="button" class="btn-close-share-room-modal p-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-zinc-400 hover:text-white">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>

        <form id="formShareRoomInChat" class="space-y-4">
            <div>
                <label class="block text-[11px] font-black uppercase text-zinc-400 mb-1">Enviar na Conversa (Canal / Grupo / DM)</label>
                <select id="selectShareRoomTargetChat" class="w-full bg-slate-950 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white font-bold focus:outline-none focus:border-indigo-500">
                    <option value="">Carregando conversas...</option>
                </select>
            </div>

            <div>
                <label class="block text-[11px] font-black uppercase text-zinc-400 mb-1">Selecione a Sala 3D</label>
                <select id="selectShareRoomId" class="w-full bg-slate-950 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white font-bold focus:outline-none focus:border-indigo-500">
                    <option value="">Carregando salas...</option>
                </select>
            </div>

            <div class="p-3.5 rounded-2xl bg-slate-950/90 border border-white/10 space-y-2.5">
                <div class="flex items-center justify-between gap-2">
                    <span class="text-[11px] font-black uppercase text-indigo-300 flex items-center gap-1.5">
                        <i class="fa-solid fa-server"></i>
                        <span>Instâncias Ativas da Sala</span>
                    </span>
                    <span id="lblShareRoomInstancesSummary" class="text-[10px] font-bold text-zinc-400">0 instâncias</span>
                </div>

                <div id="shareRoomServerInstancesList" class="space-y-1.5 max-h-44 overflow-y-auto">
                    <div class="text-xs text-zinc-500 text-center py-2">Selecione uma sala acima para ver as instâncias do servidor.</div>
                </div>

                <label class="flex items-center gap-2 pt-1.5 border-t border-white/5 cursor-pointer text-[11px] text-amber-300 font-bold">
                    <input type="checkbox" id="chkShareForceNewReplica" class="rounded bg-slate-900 border-white/20 text-indigo-600 focus:ring-0">
                    <span>➕ Forçar abertura de uma Nova Instância Replicada ao enviar convite</span>
                </label>
            </div>

            <div>
                <label class="block text-[11px] font-black uppercase text-zinc-400 mb-1">Mensagem de Convite (Opcional)</label>
                <input type="text" id="inputShareRoomCustomText" maxlength="300" placeholder="Ex: Pessoal, entrem aqui na minha sala na Instância #1!"
                       class="w-full bg-slate-950 border border-white/10 rounded-xl px-3.5 py-2 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-indigo-500">
            </div>

            <div class="flex items-center justify-end gap-2 pt-2">
                <button type="button" class="btn-close-share-room-modal px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-bold text-zinc-300">
                    Cancelar
                </button>
                <button type="submit" id="btnConfirmSendRoomInvite" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-black uppercase tracking-wider shadow-lg shadow-indigo-600/30 flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px]">send</span>
                    <span>Enviar Endereço da Sala</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ================= MODAL 2: GERENCIAR & REPLICAR INSTÂNCIAS DO SERVIDOR DA SALA ================= -->
<div id="modalRoomServerInstances" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-sky-500/30 rounded-3xl max-w-2xl w-full p-5 sm:p-6 space-y-4 shadow-2xl max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-2xl bg-sky-500/15 border border-sky-500/30 flex items-center justify-center text-sky-400">
                    <i class="fa-solid fa-network-wired text-lg"></i>
                </div>
                <div>
                    <h4 id="modalInstancesRoomTitle" class="text-sm sm:text-base font-black uppercase text-white">Instâncias do Servidor da Sala</h4>
                    <p class="text-[11px] text-zinc-400">Sempre que uma instância enche, o servidor cria outra réplica automaticamente</p>
                </div>
            </div>
            <button type="button" class="btn-close-room-instances-modal p-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-zinc-400 hover:text-white">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>

        <input type="hidden" id="modalInstancesRoomId" value="">
        <input type="hidden" id="modalInstancesRoomName" value="">

        <div class="grid grid-cols-3 gap-2.5 text-center">
            <div class="p-3 rounded-2xl bg-slate-950 border border-white/5">
                <div class="text-[10px] font-bold uppercase text-zinc-400">Instâncias Ativas</div>
                <div id="lblModalInstancesCount" class="text-base font-black text-sky-400 mt-0.5">0</div>
            </div>
            <div class="p-3 rounded-2xl bg-slate-950 border border-white/5">
                <div class="text-[10px] font-bold uppercase text-zinc-400">Jogadores Online</div>
                <div id="lblModalInstancesPlayers" class="text-base font-black text-emerald-400 mt-0.5">0 / 0</div>
            </div>
            <div class="p-3 rounded-2xl bg-slate-950 border border-white/5">
                <div class="text-[10px] font-bold uppercase text-zinc-400">Auto-Replicação</div>
                <div class="text-xs font-black text-amber-400 mt-1">⚡ Ativa (Ao Lotar)</div>
            </div>
        </div>

        <div id="modalRoomInstancesListContainer" class="space-y-2.5 max-h-72 overflow-y-auto">
            <div class="p-6 text-center text-xs text-zinc-500">Carregando instâncias da sala...</div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-white/10">
            <div class="flex flex-wrap items-center gap-2">
                <button type="button" id="btnSpawnNewRoomReplica" class="px-3 py-2 rounded-xl bg-emerald-600/20 hover:bg-emerald-600 border border-emerald-500/40 text-emerald-300 hover:text-white text-[11px] font-black uppercase transition flex items-center gap-1.5">
                    <i class="fa-solid fa-plus"></i>
                    <span>Abrir Nova Réplica</span>
                </button>
                <button type="button" id="btnSimulateFullAndReplicate" class="px-3 py-2 rounded-xl bg-amber-500/15 hover:bg-amber-500 border border-amber-500/40 text-amber-300 hover:text-slate-950 text-[11px] font-black uppercase transition flex items-center gap-1.5">
                    <i class="fa-solid fa-users-rays"></i>
                    <span>Simular Sala Cheia &amp; Auto-Replicar</span>
                </button>
            </div>

            <div class="flex items-center gap-2">
