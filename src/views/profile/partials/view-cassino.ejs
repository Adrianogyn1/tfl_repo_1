<!-- ================= VIEW: CASSINO TFL (TESTE FUNCIONAL EM FICHAS / CHIPS: SLOTS, ROLETA E DADOS) ================= -->
<%
    const chipsBal = Number(wallet?.chips || 0);
    const coinsBal = Number(wallet?.coins || 0);
    const rateChips = Number(marketStats?.rateChipsPerCoin || 10);
%>
<section id="view-cassino" class="view-section hidden p-6 md:p-10 max-w-6xl mx-auto space-y-8">

    <!-- HEADER DO CASSINO -->
    <div class="relative overflow-hidden rounded-3xl border border-purple-500/30 bg-gradient-to-br from-purple-950/50 via-slate-900/95 to-slate-950 p-6 md:p-8 shadow-2xl">
        <div class="absolute -top-20 -right-20 w-72 h-72 bg-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative flex flex-col lg:flex-row lg:items-center justify-between gap-6">
            <div class="space-y-2 max-w-2xl">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/20 border border-purple-500/40 text-purple-300 text-[11px] font-black uppercase tracking-widest">
                    <i class="fa-solid fa-dice text-purple-400"></i>
                    <span>Entretenimento & Sorte — Fichas (Chips)</span>
                </div>
                <h1 class="text-2xl md:text-4xl font-display font-black uppercase italic text-white">
                    Cassino <span class="text-amber-400">The Fantasy Life</span>
                </h1>
                <p class="text-xs md:text-sm text-zinc-300">
                    Divirta-se usando exclusivamente <strong class="text-sky-400">Fichas (Chips 🎲)</strong>. Multiplique suas fichas no Golden Tiger 3x3, na Roleta ou nos Dados da Fortuna e converta seus ganhos para <strong class="text-amber-400">Coins</strong> na Carteira quando quiser!
                </p>
            </div>

            <!-- PAINEL DE SALDO E TROCA RÁPIDA DE FICHAS -->
            <div class="p-4 rounded-2xl bg-slate-950/90 border border-white/10 min-w-[290px] space-y-3">
                <div class="grid grid-cols-2 gap-2 text-center">
                    <div class="p-2.5 rounded-xl bg-slate-900 border border-sky-500/30">
                        <div class="text-[10px] font-bold uppercase text-zinc-400">Suas Fichas (Chips)</div>
                        <div class="text-base font-black text-sky-400 flex items-center justify-center gap-1 mt-0.5">
                            <i class="fa-solid fa-dice"></i>
                            <span id="casinoChipsBalance"><%= Math.floor(chipsBal).toLocaleString('pt-BR') %></span>
                        </div>
                    </div>
                    <div class="p-2.5 rounded-xl bg-slate-900 border border-amber-500/30">
                        <div class="text-[10px] font-bold uppercase text-zinc-400">Suas Coins</div>
                        <div class="text-base font-black text-amber-400 flex items-center justify-center gap-1 mt-0.5">
                            <i class="fa-solid fa-coins"></i>
                            <span id="casinoCoinsBalance"><%= Number(coinsBal).toFixed(1) %></span>
                        </div>
                    </div>
                </div>

                <!-- Conversão Rápida Coins -> Chips -->
                <div class="flex items-center gap-2 pt-1">
                    <input type="number" id="inputQuickCoinsToChips" min="1" step="1" value="5"
                           class="w-24 px-2.5 py-2 rounded-xl bg-slate-900 border border-white/10 text-xs text-white font-bold focus:outline-none focus:border-sky-500"
                           placeholder="Coins">
                    <button type="button" id="btnQuickBuyChips"
                            class="flex-1 py-2 px-3 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-[11px] font-black uppercase tracking-wider transition">
                        Trocar p/ +<span id="lblQuickChipsPreview"><%= 5 * rateChips %></span> Chips
                    </button>
                </div>
                <p class="text-[10px] text-zinc-500 text-center">Cotação: 1 Coin = <%= rateChips %> Chips (Fichas)</p>
            </div>
        </div>
    </div>

    <!-- SELETOR DE JOGO E VALOR DE APOSTA UNIFICADO -->
    <div class="p-4 rounded-2xl bg-slate-900/90 border border-white/10 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn-casino-tab px-4 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider transition bg-amber-500 text-slate-950 shadow-lg shadow-amber-500/20" data-game="slots">
                🐯 Golden Tiger Slots 3x3
            </button>
            <button type="button" class="btn-casino-tab px-4 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider transition bg-slate-800 text-zinc-300 hover:text-white" data-game="roulette">
                🎡 Roleta Real (2x / 14x)
            </button>
            <button type="button" class="btn-casino-tab px-4 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider transition bg-slate-800 text-zinc-300 hover:text-white" data-game="dice">
                🎲 Dados da Fortuna (2d6)
            </button>
        </div>

        <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-zinc-400">Aposta (Chips):</span>
            <input type="number" id="inputCasinoBetChips" min="1" max="50000" value="10"
                   class="w-24 px-3 py-2 rounded-xl bg-slate-950 border border-sky-500/40 text-sm font-black text-sky-400 text-center focus:outline-none">
            <div class="flex items-center gap-1">
                <button type="button" class="btn-casino-bet-preset px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] font-bold text-zinc-300" data-bet="10">10</button>
                <button type="button" class="btn-casino-bet-preset px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] font-bold text-zinc-300" data-bet="50">50</button>
                <button type="button" class="btn-casino-bet-preset px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] font-bold text-zinc-300" data-bet="100">100</button>
                <button type="button" class="btn-casino-bet-preset px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-[11px] font-bold text-zinc-300" data-bet="500">500</button>
            </div>
        </div>
    </div>

    <!-- JOGO 1: GOLDEN TIGER SLOTS 3X3 -->
    <div id="casinoGameSlots" class="casino-game-panel rounded-3xl bg-slate-900/95 border border-amber-500/30 p-6 md:p-8 shadow-xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-7 flex flex-col items-center space-y-5">
                <div class="text-center">
                    <h3 class="text-xl font-black uppercase text-amber-400 tracking-wider">🐯 Golden Tiger 3x3 — 5 Linhas de Prêmio</h3>
                    <p class="text-xs text-zinc-400">Alinhe 3 símbolos iguais nas linhas horizontais ou diagonais para multiplicar suas fichas!</p>
                </div>

                <!-- GRADE 3X3 DO CAÇA-NÍQUEL -->
                <div id="slotsGrid3x3" class="grid grid-cols-3 gap-3 p-4 rounded-3xl bg-gradient-to-b from-amber-500/20 via-slate-950 to-slate-950 border-2 border-amber-500/50 shadow-2xl w-full max-w-sm">
                    <div class="slot-cell h-24 rounded-2xl bg-slate-900 border border-white/10 flex items-center justify-center text-4xl select-none shadow-inner">🐯</div>
                    <div class="slot-cell h-24 rounded-2xl bg-slate-900 border border-white/10 flex items-center justify-center text-4xl select-none shadow-inner">💎</div>
                    <div class="slot-cell h-24 rounded-2xl bg-slate-900 border border-white/10 flex items-center justify-center text-4xl select-none shadow-inner">7️⃣</div>
                    <div class="slot-cell h-24 rounded-2xl bg-slate-900 border border-amber-500/40 flex items-center justify-center text-4xl select-none shadow-inner">🐯</div>
                    <div class="slot-cell h-24 rounded-2xl bg-slate-900 border border-amber-500/40 flex items-center justify-center text-4xl select-none shadow-inner">🐯</div>
                    <div class="slot-cell h-24 rounded-2xl bg-slate-900 border border-amber-500/40 flex items-center justify-center text-4xl select-none shadow-inner">🐯</div>
                    <div class="slot-cell h-24 rounded-2xl bg-slate-900 border border-white/10 flex items-center justify-center text-4xl select-none shadow-inner">👑</div>
                    <div class="slot-cell h-24 rounded-2xl bg-slate-900 border border-white/10 flex items-center justify-center text-4xl select-none shadow-inner">🍀</div>
                    <div class="slot-cell h-24 rounded-2xl bg-slate-900 border border-white/10 flex items-center justify-center text-4xl select-none shadow-inner">🍒</div>
                </div>

                <button type="button" id="btnSpinSlots"
                        class="w-full max-w-sm py-4 px-6 rounded-2xl bg-gradient-to-r from-amber-500 via-yellow-400 to-amber-500 hover:from-amber-400 hover:to-yellow-300 text-slate-950 text-base font-black uppercase tracking-widest shadow-xl shadow-amber-500/20 transition transform active:scale-95">
                    🎰 GIRAR AGORA
                </button>
            </div>

            <!-- TABELA DE PAGAMENTOS DO SLOTS -->
            <div class="lg:col-span-5 p-5 rounded-2xl bg-slate-950/90 border border-white/10 space-y-4">
                <h4 class="text-xs font-black uppercase tracking-widest text-amber-400">Tabela de Multiplicadores</h4>
                <div class="grid grid-cols-2 gap-2.5 text-xs">
                    <div class="p-2.5 rounded-xl bg-slate-900 border border-amber-500/30 flex items-center justify-between">
                        <span>7️⃣ 7️⃣ 7️⃣</span>
                        <span class="font-black text-amber-400">15x</span>
                    </div>
                    <div class="p-2.5 rounded-xl bg-slate-900 border border-white/5 flex items-center justify-between">
                        <span>💎 💎 💎</span>
                        <span class="font-black text-sky-400">8x</span>
                    </div>
                    <div class="p-2.5 rounded-xl bg-slate-900 border border-white/5 flex items-center justify-between">
                        <span>🐯 🐯 🐯</span>
                        <span class="font-black text-amber-300">5x</span>
                    </div>
                    <div class="p-2.5 rounded-xl bg-slate-900 border border-white/5 flex items-center justify-between">
                        <span>👑 👑 👑</span>
                        <span class="font-black text-purple-400">3.5x</span>
                    </div>
                    <div class="p-2.5 rounded-xl bg-slate-900 border border-white/5 flex items-center justify-between">
                        <span>🍀 🍀 🍀</span>
                        <span class="font-black text-emerald-400">2.2x</span>
                    </div>
                    <div class="p-2.5 rounded-xl bg-slate-900 border border-white/5 flex items-center justify-between">
                        <span>🍒 🍒 (Par Central)</span>
                        <span class="font-black text-zinc-300">1.2x</span>
                    </div>
                </div>
                <div id="slotsResultBanner" class="p-3.5 rounded-xl bg-slate-900 border border-white/10 text-center text-xs font-bold text-zinc-300">
                    Escolha sua aposta em Fichas e clique em <strong>GIRAR AGORA</strong>!
                </div>
            </div>
        </div>
    </div>

    <!-- JOGO 2: ROLETA REAL (2X / 14X) -->
    <div id="casinoGameRoulette" class="casino-game-panel hidden rounded-3xl bg-slate-900/95 border border-rose-500/30 p-6 md:p-8 shadow-xl space-y-6">
        <div class="text-center space-y-1">
            <h3 class="text-xl font-black uppercase text-white tracking-wider">🎡 Roleta Real TFL (0 a 14)</h3>
            <p class="text-xs text-zinc-400">Escolha sua cor para girar a roleta: Vermelho (1 a 7) paga <strong>2x</strong>, Preto (8 a 14) paga <strong>2x</strong> e Ouro (0) paga <strong>14x</strong>!</p>
        </div>

        <!-- FAIXA DE NÚMEROS DA ROLETA -->
        <div id="rouletteWheelStrip" class="flex flex-wrap items-center justify-center gap-2 p-4 rounded-2xl bg-slate-950 border border-white/10">
            <div class="roulette-num w-11 h-11 rounded-xl bg-amber-500 text-slate-950 font-black flex items-center justify-center text-sm shadow" data-num="0">0</div>
            <% for (let n = 1; n <= 14; n++) { %>
                <div class="roulette-num w-11 h-11 rounded-xl <%= n <= 7 ? 'bg-rose-600 text-white' : 'bg-zinc-800 text-zinc-100 border border-white/15' %> font-black flex items-center justify-center text-sm" data-num="<%= n %>"><%= n %></div>
            <% } %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <button type="button" class="btn-play-roulette py-4 px-5 rounded-2xl bg-rose-600 hover:bg-rose-500 text-white font-black uppercase tracking-wider transition shadow-lg" data-choice="red">
                🔴 Apostar no Vermelho (2x)
            </button>
            <button type="button" class="btn-play-roulette py-4 px-5 rounded-2xl bg-gradient-to-r from-amber-500 to-yellow-400 hover:from-amber-400 hover:to-yellow-300 text-slate-950 font-black uppercase tracking-wider transition shadow-lg" data-choice="gold">
                🟡 Apostar no Zero Ouro (14x)
            </button>
            <button type="button" class="btn-play-roulette py-4 px-5 rounded-2xl bg-zinc-800 hover:bg-zinc-700 border border-white/15 text-white font-black uppercase tracking-wider transition shadow-lg" data-choice="black">
                ⚫ Apostar no Preto (2x)
            </button>
        </div>

        <div id="rouletteResultBanner" class="p-3.5 rounded-xl bg-slate-950 border border-white/10 text-center text-xs font-bold text-zinc-300">
            Clique em uma das cores acima para girar a Roleta!
        </div>
    </div>

    <!-- JOGO 3: DADOS DA FORTUNA (2D6) -->
    <div id="casinoGameDice" class="casino-game-panel hidden rounded-3xl bg-slate-900/95 border border-sky-500/30 p-6 md:p-8 shadow-xl space-y-6">
        <div class="text-center space-y-1">
            <h3 class="text-xl font-black uppercase text-sky-400 tracking-wider">🎲 Dados da Fortuna (2 Dados)</h3>
            <p class="text-xs text-zinc-400">Lance dois dados e acerte a soma: Baixo (2 a 6) paga <strong>2x</strong>, Lucky 7 (Soma 7) paga <strong>4.5x</strong> e Alto (8 a 12) paga <strong>2x</strong>!</p>
        </div>

        <div class="flex items-center justify-center gap-6 py-4">
            <div id="diceBox1" class="w-24 h-24 rounded-3xl bg-slate-950 border-2 border-sky-500/50 flex items-center justify-center text-4xl font-black text-white shadow-2xl">🎲 3</div>
            <span class="text-2xl font-black text-zinc-500">+</span>
            <div id="diceBox2" class="w-24 h-24 rounded-3xl bg-slate-950 border-2 border-sky-500/50 flex items-center justify-center text-4xl font-black text-white shadow-2xl">🎲 4</div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <button type="button" class="btn-play-dice py-4 px-5 rounded-2xl bg-sky-600 hover:bg-sky-500 text-white font-black uppercase tracking-wider transition shadow-lg" data-choice="low">
                🔽 Baixo (Soma 2 a 6) — 2x
            </button>
            <button type="button" class="btn-play-dice py-4 px-5 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black uppercase tracking-wider transition shadow-lg" data-choice="seven">
                🎯 Lucky 7 (Soma Exata 7) — 4.5x
            </button>
            <button type="button" class="btn-play-dice py-4 px-5 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-black uppercase tracking-wider transition shadow-lg" data-choice="high">
                🔼 Alto (Soma 8 a 12) — 2x
            </button>
        </div>

        <div id="diceResultBanner" class="p-3.5 rounded-xl bg-slate-950 border border-white/10 text-center text-xs font-bold text-zinc-300">
            Escolha sua previsão acima para lançar os dados!
        </div>
    </div>

    <!-- HISTÓRICO DE JOGADAS RECENTES NA SESSÃO -->
    <div class="p-6 rounded-2xl bg-slate-900/90 border border-white/10 space-y-3">
        <h3 class="text-xs font-black uppercase tracking-widest text-zinc-400 flex items-center gap-2">
            <i class="fa-solid fa-clock-rotate-left text-purple-400"></i>
            <span>Últimas Jogadas no Cassino</span>
        </h3>
        <div id="casinoHistoryList" class="space-y-2 text-xs text-zinc-400">
            <div class="p-3 rounded-xl bg-slate-950/60 border border-white/5 text-center">
                Suas jogadas desta sessão aparecerão aqui em tempo real (e também ficam registradas no Extrato Completo da Carteira).
            </div>
        </div>
    </div>
</section>
