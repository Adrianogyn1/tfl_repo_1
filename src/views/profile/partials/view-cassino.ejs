                    </div>
                </div>

                <!-- Coins Balance Pill -->
                <div class="flex items-center gap-2 bg-slate-900/90 border border-amber-500/30 rounded-2xl px-3.5 py-2 shadow-inner">
                    <i class="fa-solid fa-coins text-amber-400 text-sm"></i>
                    <div>
                        <div class="text-[9px] font-bold uppercase tracking-wider text-zinc-400">Suas Coins</div>
                        <div class="text-xs sm:text-sm font-black text-amber-300 font-mono leading-none">
