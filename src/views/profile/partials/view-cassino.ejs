                    <i class="fa-solid fa-arrows-rotate"></i>
                    <span>Obter Fichas</span>
                </button>

                <!-- Contrato de Sessão Pill -->
                <div id="casinoSessionContractWidget" class="flex items-center gap-2 bg-slate-900/90 border border-purple-500/40 rounded-2xl px-3 py-1.5 text-xs">
                    <div class="min-w-0">
                        <span class="text-[9px] text-zinc-400 uppercase font-bold block leading-tight">Contrato PIN</span>
