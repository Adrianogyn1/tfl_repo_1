    <!-- ========================================================================= -->
    <!-- 1. HEADER DO CASSINO ESTILO STAKE / BETANO                                -->
    <!-- ========================================================================= -->
    <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-r from-slate-950 via-[#0d1322] to-slate-950 p-4 sm:p-6 shadow-2xl">
