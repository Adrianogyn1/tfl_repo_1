                        </div>
                    </div>
                </div>

                <!-- Botão de Câmbio de Fichas (Max 80%) -->
                <button type="button" onclick="$('#btnOpenQuickConvertModal').trigger('click')"
                    class="px-3 py-2 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-black uppercase tracking-wider shadow-lg shadow-emerald-600/25 transition flex items-center gap-1.5"
