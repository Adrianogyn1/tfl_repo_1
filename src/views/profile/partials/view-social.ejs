<!-- ================= VIEW 1: REDE SOCIAL (FEED DO AVATAR - ICON-FIRST & I18N) ================= -->
<section id="view-social" class="view-panel p-4 sm:p-6 lg:p-8 max-w-5xl mx-auto w-full space-y-5">

    <!-- ================= BARRA DE MINI REELS (24H) E SENTIMENTO (6H) ================= -->
    <div class="bg-slate-900/85 border border-white/10 rounded-3xl p-4 shadow-xl backdrop-blur-md space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-pink-500 to-purple-600 flex items-center justify-center text-white shadow-lg shadow-pink-600/20">
                    <span class="material-symbols-outlined text-[18px]">bolt</span>
                </div>
                <h3 class="text-xs sm:text-sm font-black uppercase italic text-white"><%= t('profile.social.reels', {}, 'Reels & Humor') %></h3>
                <span id="myActiveFeelingHeaderBadge" class="hidden px-2.5 py-0.5 rounded-full bg-amber-500/15 border border-amber-400/30 text-amber-300 text-[10px] font-bold"></span>
            </div>

            <div class="flex items-center gap-2">
                <button type="button" id="btnOpenCreateFeelingReel" class="px-3 py-1.5 rounded-xl bg-amber-500/15 hover:bg-amber-500 border border-amber-500/30 text-amber-300 hover:text-slate-950 text-xs font-black transition flex items-center gap-1.5" title="Sentimento (6h)">
                    <span class="material-symbols-outlined text-[16px]">mood</span>
                    <span><%= t('profile.social.feeling6h', {}, '6h') %></span>
                </button>
                <button type="button" id="btnOpenCreatePhotoTextReel" class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-pink-600 to-purple-600 hover:from-pink-500 hover:to-purple-500 text-white text-xs font-black shadow-lg shadow-pink-600/25 transition flex items-center gap-1.5" title="Mini Reel Foto/Texto (24h)">
                    <span class="material-symbols-outlined text-[16px]">add_photo_alternate</span>
                    <span><%= t('profile.social.reel24h', {}, '24h') %></span>
                </button>
            </div>
        </div>

        <!-- Carrossel Horizontal de Cards Verticais -->
        <div id="miniReelsCarousel" class="flex items-center gap-3 overflow-x-auto pb-1.5 pt-1">
            <div class="text-xs text-zinc-500 py-3 px-2"><i class="fa-solid fa-spinner fa-spin mr-1"></i></div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        <!-- COLUNA PRINCIPAL DO FEED & GALERIA DE FOTOS (8 COLUNAS) -->
        <div class="lg:col-span-8 space-y-5">
            <!-- Caixa de Criação de Post Compacta -->
            <div class="bg-slate-900/80 border border-white/10 rounded-3xl p-4 shadow-xl backdrop-blur-md space-y-2.5">
                <div class="flex gap-3 items-center">
                    <button type="button" class="btn-open-mini-profile w-10 h-10 rounded-xl overflow-hidden border border-blue-500/40 bg-slate-950 flex-shrink-0 hover:scale-105 transition"
                            data-avatarid="<%= activeAvatar?.id %>" title="Mini Profile">
                        <img src="<%= activeAvatar?.thumbnail || user?.avatar || 'https://ui-avatars.com/api/?name=User&background=0284c7' %>" 
                             alt="Avatar" class="w-full h-full object-cover">
                    </button>
                    <input type="text" id="postTitle" placeholder="<%= t('profile.social.postTitlePlaceholder', {}, 'Título (opcional)...') %>" 
                           class="flex-1 bg-slate-950 border border-white/10 rounded-xl px-3.5 py-2 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500 transition">
                </div>

                <textarea id="postText" rows="2" placeholder="<%= t('profile.social.postTextPlaceholder', {}, 'Compartilhe algo...') %>"
                          class="w-full bg-slate-950 border border-white/10 rounded-xl p-3 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500 resize-none transition"></textarea>

                <!-- Preview da Foto anexada no Post -->
                <div id="postImagePreviewBox" class="hidden relative rounded-2xl overflow-hidden border border-white/10 bg-slate-950 max-h-60">
                    <img id="postImagePreviewImg" src="" alt="Preview" class="w-full max-h-60 object-cover">
                    <button type="button" id="btnClearPostImage" class="absolute top-2 right-2 w-7 h-7 rounded-full bg-black/80 hover:bg-red-600 text-white text-xs flex items-center justify-center transition">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <input type="file" id="filePostPhoto" accept="image/*" class="hidden">
                <input type="hidden" id="inputPostImageUrl" value="">

                <div class="flex flex-wrap justify-between items-center gap-2 pt-2 border-t border-white/5">
                    <div class="flex flex-wrap items-center gap-1.5">
                        <button type="button" id="btnUploadPostPhoto" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-zinc-300 text-xs font-bold flex items-center gap-1.5 transition" title="<%= t('profile.social.photo', {}, 'Foto') %>">
                            <span class="material-symbols-outlined text-[16px] text-blue-400">photo_camera</span>
                            <span id="labelUploadPostPhoto" class="hidden sm:inline"><%= t('profile.social.photo', {}, 'Foto') %></span>
                        </button>
                        <!-- Vincular Sala 3D ao Post -->
                        <select id="selectPostRoom" class="bg-slate-950 border border-white/10 rounded-xl px-2.5 py-2 text-xs text-zinc-300 focus:outline-none focus:border-purple-500" title="Vincular Sala 3D">
                            <option value="">🚪 <%= t('profile.social.room', {}, 'Sala 3D') %></option>
                            <% if (rooms && rooms.length > 0) { %>
                                <% rooms.forEach(function(rm) { %>
                                    <option value="<%= rm.id %>">🏠 <%= rm.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                        <!-- Privacidade Compacta por Ícones -->
                        <div class="flex items-center gap-1 bg-slate-950 border border-white/10 rounded-xl px-2 py-1.5" title="Privacidade das Publicações">
                            <span class="material-symbols-outlined text-[15px] text-blue-400">shield_lock</span>
                            <select class="select-section-privacy bg-slate-900 border border-white/10 rounded-lg px-1.5 py-0.5 text-[11px] text-white font-bold focus:outline-none cursor-pointer" data-field="privacyPosts">
                                <option value="public" <%= (activeAvatar?.privacyPosts || 'public') === 'public' ? 'selected' : '' %>>🌐 <%= t('common.public', {}, 'Público') %></option>
                                <option value="friends" <%= activeAvatar?.privacyPosts === 'friends' ? 'selected' : '' %>>👥 <%= t('common.friendsOnly', {}, 'Amigos') %></option>
                                <option value="private" <%= activeAvatar?.privacyPosts === 'private' ? 'selected' : '' %>>🔒 <%= t('common.private', {}, 'Privado') %></option>
                            </select>
                            <span class="privacy-save-status hidden text-[10px] font-bold text-emerald-400">✔</span>
                        </div>
                        <button type="button" class="btn-navigate-user-profile p-2 rounded-xl bg-slate-950 hover:bg-slate-800 border border-white/10 text-emerald-400 text-xs transition"
                                data-avatarid="<%= activeAvatar?.id %>" title="<%= t('profile.social.myProfile', {}, 'Perfil') %>">
                            <span class="material-symbols-outlined text-[18px]">account_circle</span>
                        </button>
                    </div>
                    <button type="button" id="btnPublishPost" class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-blue-600/30 transition flex items-center gap-1.5" title="<%= t('profile.social.publish', {}, 'Publicar') %>">
                        <span class="material-symbols-outlined text-[16px]">send</span>
                        <span><%= t('profile.social.publish', {}, 'Publicar') %></span>
                    </button>
                </div>
            </div>

            <!-- Filtros do Feed Social & Aba Galeria de Fotos (Ícones + Texto Curto) -->
            <div class="flex flex-wrap justify-between items-center gap-2 bg-slate-900/60 border border-white/10 rounded-2xl p-2">
                <div class="flex flex-wrap items-center gap-1">
                    <button type="button" class="btn-feed-filter px-3 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider transition bg-blue-600 text-white flex items-center gap-1" data-filter="all" title="<%= t('profile.social.explore', {}, 'Explorar') %>">
                        <span class="material-symbols-outlined text-[16px]">public</span>
                        <span><%= t('profile.social.explore', {}, 'Explorar') %></span>
                    </button>
                    <button type="button" class="btn-feed-filter px-3 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider transition text-zinc-400 hover:text-white hover:bg-slate-800 flex items-center gap-1" data-filter="friends" title="<%= t('profile.social.friends', {}, 'Amigos') %>">
                        <span class="material-symbols-outlined text-[16px]">group</span>
                        <span><%= t('profile.social.friends', {}, 'Amigos') %></span>
                    </button>
                    <button type="button" class="btn-feed-filter px-3 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider transition text-zinc-400 hover:text-white hover:bg-slate-800 flex items-center gap-1" data-filter="mine" title="<%= t('profile.social.mine', {}, 'Meus') %>">
                        <span class="material-symbols-outlined text-[16px]">person</span>
                        <span><%= t('profile.social.mine', {}, 'Meus') %></span>
                    </button>
                    <button type="button" id="btnSwitchToPhotoGallery" class="px-3 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider transition text-amber-300 hover:text-white bg-amber-500/10 hover:bg-amber-600 border border-amber-500/30 flex items-center gap-1" title="<%= t('profile.social.gallery', {}, 'Galeria') %>">
                        <span class="material-symbols-outlined text-[16px]">photo_library</span>
                        <span><%= t('profile.social.gallery', {}, 'Galeria') %></span>
                    </button>
                </div>
                <button type="button" id="btnReloadFeed" class="p-2 rounded-xl text-blue-400 hover:text-white hover:bg-slate-800 transition" title="<%= t('common.refresh', {}, 'Atualizar') %>">
                    <span class="material-symbols-outlined text-[18px]">refresh</span>
                </button>
            </div>

            <!-- PAINEL: GALERIA DE FOTOS -->
            <div id="socialPhotoGalleryPanel" class="hidden bg-slate-900/80 border border-white/10 rounded-3xl p-4 shadow-xl space-y-3.5">
                <div class="flex flex-wrap items-center justify-between gap-2 pb-2.5 border-b border-white/10">
                    <h4 class="text-xs sm:text-sm font-black uppercase italic text-white flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px] text-amber-400">photo_library</span>
                        <span><%= t('profile.social.gallery', {}, 'Galeria') %></span>
                    </h4>
                    <div class="flex flex-wrap items-center gap-2">
                        <div class="flex items-center gap-1 bg-slate-950 border border-amber-500/25 rounded-xl px-2.5 py-1" title="Privacidade das Fotos">
                            <span class="material-symbols-outlined text-[15px] text-amber-400">shield_lock</span>
                            <select class="select-section-privacy bg-slate-900 border border-white/10 rounded-lg px-1.5 py-0.5 text-[11px] text-white font-bold focus:outline-none cursor-pointer" data-field="privacyPhotos">
                                <option value="public" <%= (activeAvatar?.privacyPhotos || 'public') === 'public' ? 'selected' : '' %>>🌐 <%= t('common.public', {}, 'Público') %></option>
                                <option value="friends" <%= activeAvatar?.privacyPhotos === 'friends' ? 'selected' : '' %>>👥 <%= t('common.friendsOnly', {}, 'Amigos') %></option>
                                <option value="private" <%= activeAvatar?.privacyPhotos === 'private' ? 'selected' : '' %>>🔒 <%= t('common.private', {}, 'Privado') %></option>
                            </select>
                            <span class="privacy-save-status hidden text-[10px] font-bold text-emerald-400">✔</span>
                        </div>
                        <button type="button" id="btnOpenUploadGalleryModal" class="px-3 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-black uppercase tracking-wider transition flex items-center gap-1 shadow-lg shadow-amber-500/20" title="<%= t('profile.social.addPhoto', {}, 'Nova Foto') %>">
                            <span class="material-symbols-outlined text-[16px]">cloud_upload</span>
                            <span><%= t('profile.social.addPhoto', {}, 'Nova Foto') %></span>
                        </button>
                    </div>
                </div>

                <!-- Subfiltros da Galeria -->
                <div class="flex flex-wrap items-center gap-1.5">
                    <button type="button" class="btn-gallery-filter px-3 py-1 rounded-xl text-[11px] font-black uppercase bg-amber-500 text-slate-950 transition flex items-center gap-1" data-filter="all">
                        <span class="material-symbols-outlined text-[14px]">grid_view</span>
                        <span><%= t('profile.social.allPhotos', {}, 'Todas') %></span>
                    </button>
                    <button type="button" class="btn-gallery-filter px-3 py-1 rounded-xl text-[11px] font-black uppercase bg-slate-950 text-zinc-400 hover:text-white transition flex items-center gap-1" data-filter="friends">
                        <span class="material-symbols-outlined text-[14px]">group</span>
                        <span><%= t('profile.social.friends', {}, 'Amigos') %></span>
                    </button>
                    <button type="button" class="btn-gallery-filter px-3 py-1 rounded-xl text-[11px] font-black uppercase bg-slate-950 text-zinc-400 hover:text-white transition flex items-center gap-1" data-filter="mine">
                        <span class="material-symbols-outlined text-[14px]">person</span>
                        <span><%= t('profile.social.myPhotos', {}, 'Minhas') %></span>
                    </button>
                </div>

                <!-- Grid de Fotos da Galeria -->
                <div id="socialPhotoGalleryGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                    <div class="col-span-full p-6 text-center text-xs text-zinc-500"><i class="fa-solid fa-spinner fa-spin"></i></div>
                </div>
            </div>

            <!-- Feed de Publicações -->
            <div id="postsFeedContainer" class="space-y-4">
                <div class="bg-slate-900/60 border border-white/5 rounded-2xl p-6 text-center text-zinc-500 text-xs">
                    <i class="fa-solid fa-spinner fa-spin text-lg text-blue-500"></i>
                </div>
            </div>
        </div>

        <!-- COLUNA LATERAL DA REDE SOCIAL (4 COLUNAS) -->
        <div class="lg:col-span-4 space-y-5">
            <!-- Card Rápido do Avatar Ativo -->
            <div class="bg-slate-900/80 border border-white/10 rounded-3xl overflow-hidden shadow-xl">
                <div class="h-16 bg-gradient-to-r from-blue-900/70 via-indigo-900/60 to-purple-900/70 relative overflow-hidden">
                    <% if (activeAvatar?.coverUrl) { %>
                        <img src="<%= activeAvatar.coverUrl %>" alt="Capa" class="w-full h-full object-cover">
                    <% } %>
                </div>
                <div class="p-4 -mt-9 relative space-y-3">
                    <div class="flex items-end justify-between gap-2">
                        <div class="flex items-end gap-3 overflow-hidden">
                            <img src="<%= activeAvatar?.thumbnail || user?.avatar || 'https://ui-avatars.com/api/?name=Avatar&background=0284c7' %>"
                                 class="w-14 h-14 rounded-2xl object-cover border-4 border-slate-900 bg-slate-950 shadow-lg flex-shrink-0">
                            <div class="overflow-hidden pb-0.5">
                                <h4 class="text-xs sm:text-sm font-black uppercase italic text-white truncate"><%= activeAvatar?.name %></h4>
                                <p class="text-[10px] text-emerald-400 font-semibold flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                    <span>Online agora</span>
                                </p>
                            </div>
                        </div>
                        <button type="button" class="btn-navigate-user-profile p-2 rounded-xl bg-blue-600/20 hover:bg-blue-600 border border-blue-500/30 text-blue-400 hover:text-white transition flex-shrink-0"
                                data-avatarid="<%= activeAvatar?.id %>" title="<%= t('profile.social.myProfile', {}, 'Perfil') %>">
                            <span class="material-symbols-outlined text-[18px]">open_in_new</span>
                        </button>
                    </div>
                    <!-- Sentimento Atual (6h) -->
                    <div id="sidebarCardMyFeelingBox" class="hidden p-2 rounded-xl bg-amber-500/10 border border-amber-500/25 flex items-center justify-between gap-2 text-xs">
                        <span id="sidebarCardMyFeelingText" class="font-bold text-amber-300 truncate"></span>
                        <span id="sidebarCardMyFeelingTimer" class="text-[10px] text-zinc-400 flex-shrink-0"></span>
                    </div>
                    <div class="grid grid-cols-2 gap-2 pt-1 text-center">
                        <div class="p-2 rounded-xl bg-slate-950 border border-white/5 flex items-center justify-center gap-2" title="<%= t('profile.social.friends', {}, 'Amigos') %>">
                            <span class="material-symbols-outlined text-[16px] text-emerald-400">group</span>
                            <span class="text-xs font-black text-emerald-400"><%= friendsData?.friendsList?.length || 0 %></span>
                        </div>
                        <div class="p-2 rounded-xl bg-slate-950 border border-white/5 flex items-center justify-center gap-2" title="<%= t('profile.social.rooms', {}, 'Salas') %>">
                            <span class="material-symbols-outlined text-[16px] text-blue-400">deployed_code</span>
                            <span class="text-xs font-black text-blue-400"><%= rooms?.length || 0 %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Viajantes Sugeridos & Match -->
            <div class="bg-slate-900/80 border border-white/10 rounded-3xl p-4 shadow-xl space-y-3">
                <h4 class="text-xs font-black uppercase italic text-zinc-300 flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px] text-pink-400">local_fire_department</span>
                    <span><%= t('profile.social.peopleAndMatch', {}, 'Viajantes & Match') %></span>
                </h4>
                <div class="space-y-2">
                    <% if (friendsData?.suggestedAvatars && friendsData.suggestedAvatars.length > 0) { %>
                        <% friendsData.suggestedAvatars.slice(0, 6).forEach(function(sug) { %>
                            <div class="p-2 rounded-2xl bg-slate-950 border border-white/5 flex items-center justify-between gap-2">
                                <button type="button" class="btn-open-mini-profile flex items-center gap-2 overflow-hidden text-left group flex-1"
                                        data-avatarid="<%= sug.id %>">
                                    <img src="<%= sug.thumbnail || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(sug.name || 'Avatar') + '&background=0284c7&color=fff' %>"
                                         class="w-8 h-8 rounded-xl object-cover border border-white/10 flex-shrink-0">
                                    <div class="overflow-hidden">
                                        <div class="text-xs font-bold text-white group-hover:text-sky-400 transition truncate"><%= sug.name %></div>
                                        <div class="text-[10px] text-zinc-400 truncate"><%= sug.lastSeenLabel || 'Visto recentemente' %></div>
                                    </div>
                                </button>
                                <div class="flex items-center gap-1 flex-shrink-0">
                                    <button type="button" class="btn-toggle-match p-1.5 rounded-xl bg-pink-600/20 hover:bg-pink-600 border border-pink-500/30 text-pink-400 hover:text-white text-xs transition"
                                            data-targetid="<%= sug.id %>" title="Match / Crush 💘">
                                        <span class="material-symbols-outlined text-[15px]">local_fire_department</span>
                                    </button>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>
