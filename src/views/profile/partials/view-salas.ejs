<!-- ================= VIEW 3: SALAS 3D VIRTUAIS (PREVIEW, CURTIR, PASSE 24H E EXPLORADOR) ================= -->
<section id="view-salas" class="view-panel hidden p-4 sm:p-6 lg:p-8 max-w-5xl mx-auto w-full space-y-5">
    <%
        const roomFeePct = Number(marketStats?.roomEntryPlatformFeePercent ?? 15);
        const roomOwnerPct = Number(marketStats?.roomOwnerSharePercent ?? (100 - roomFeePct));
        const roomPassHours = Number(marketStats?.roomPassDurationHours || 24);
        const boostFeeCoins = Number(marketStats?.roomBoost24hFeeCoins ?? 20);
        const pubRoomsList = Array.isArray(publicRooms) ? publicRooms : [];
    %>

    <div class="flex flex-wrap justify-between items-center gap-3">
        <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="btn-rooms-subtab px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition bg-indigo-600 text-white shadow-lg shadow-indigo-600/20 flex items-center gap-1.5" data-subtab="my-rooms">
                <span class="material-symbols-outlined text-[16px]">deployed_code</span>
                <span>Minhas Salas (<%= rooms ? rooms.length : 0 %>)</span>
            </button>
            <button type="button" class="btn-rooms-subtab px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition bg-slate-900 border border-white/10 text-zinc-300 hover:text-white flex items-center gap-1.5" data-subtab="explore-rooms">
                <span class="material-symbols-outlined text-[16px] text-amber-400">travel_explore</span>
                <span>Explorar Salas Públicas</span>
            </button>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <div class="flex items-center gap-1.5 bg-slate-900 border border-purple-500/25 rounded-xl px-2.5 py-1.5" title="Privacidade de Salas">
                <span class="material-symbols-outlined text-[16px] text-purple-400">shield_lock</span>
                <select class="select-section-privacy bg-slate-950 border border-white/10 rounded-lg px-2 py-0.5 text-xs text-white font-bold focus:outline-none cursor-pointer" data-field="privacyRooms">
                    <option value="public" <%= (activeAvatar?.privacyRooms || 'public') === 'public' ? 'selected' : '' %>>🌐 <%= t('common.public', {}, 'Público') %></option>
                    <option value="friends" <%= activeAvatar?.privacyRooms === 'friends' ? 'selected' : '' %>>👥 <%= t('common.friendsOnly', {}, 'Amigos') %></option>
                    <option value="private" <%= activeAvatar?.privacyRooms === 'private' ? 'selected' : '' %>>🔒 <%= t('common.private', {}, 'Privado') %></option>
                </select>
                <span class="privacy-save-status hidden text-[10px] font-bold text-emerald-400">✔</span>
            </div>
            <button id="btnOpenCreateRoomModal" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold uppercase tracking-wider transition flex items-center gap-1.5 shadow-lg shadow-emerald-600/20">
                <span class="material-symbols-outlined text-[16px]">add_home</span>
                <span><%= t('profile.rooms.newRoom', {}, 'Nova Sala') %></span>
            </button>
        </div>
    </div>

    <!-- Banner Acolhedor de Apresentação das Salas 3D -->
    <div class="bg-gradient-to-r from-indigo-950/70 via-slate-900 to-purple-950/40 border border-indigo-500/20 rounded-3xl p-5 shadow-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-2xl bg-indigo-500/15 border border-indigo-500/30 flex items-center justify-center text-indigo-400 flex-shrink-0">
                <span class="material-symbols-outlined text-[22px]">view_in_ar</span>
            </div>
            <div>
                <h3 class="text-sm font-black text-white uppercase italic tracking-wider flex items-center gap-2">
                    <span>Espaços Virtuais 3D</span>
                    <span class="px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 text-[10px] font-bold">Comunidade</span>
                </h3>
                <p class="text-xs text-zinc-300 mt-0.5">
                    Crie e decore seu próprio espaço, receba amigos para conversar e explore ambientes criados por outros viajantes.
                </p>
            </div>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0 text-xs text-zinc-400">
            <span class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-950/70 border border-white/5">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Mundo Aberto</span>
            </span>
        </div>
    </div>

    <!-- SUB-ABA 1: MINHAS SALAS -->
    <div id="subtabRoomsMine" class="rooms-subtab-panel grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <% if (rooms && rooms.length > 0) { %>
            <% rooms.forEach(function(room) {
                const entryPrice = Number(room.entryValue || 0);
                const isPaid = entryPrice > 0;
                const totalVis = Number(room.totalVisits || room.visits || 0);
                const isBoosted = room.boostExpiresAt && new Date(room.boostExpiresAt) > new Date();
                const roomThumb = room.thumbnail || room.previewUrl || 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=600&q=80';
            %>
                <div class="bg-slate-900/80 border <%= isBoosted ? 'border-amber-500/50 shadow-lg shadow-amber-500/10' : 'border-white/10' %> rounded-2xl p-4 space-y-3 backdrop-blur-md hover:border-indigo-500/40 transition flex flex-col justify-between">
                    <div class="space-y-2.5">
                        <!-- Imagem de Preview da Sala -->
                        <div class="h-32 rounded-xl overflow-hidden bg-slate-950 border border-white/5 relative group">
                            <img src="<%= roomThumb %>" alt="<%= room.name || 'Sala' %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent"></div>
                            <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5">
                                <% if (isBoosted) { %>
                                    <span class="px-2 py-0.5 rounded-md bg-amber-500 text-slate-950 text-[9px] font-black uppercase shadow">
                                        🚀 Destaque
                                    </span>
                                <% } %>
                                <% if (isPaid) { %>
                                    <span class="px-2 py-0.5 rounded-md bg-amber-500/90 text-slate-950 text-[10px] font-black shadow">
                                        🎟️ <%= entryPrice %> Coins
                                    </span>
                                <% } else { %>
                                    <span class="px-2 py-0.5 rounded-md bg-emerald-500/90 text-white text-[10px] font-black shadow">
                                        Livre
                                    </span>
                                <% } %>
                            </div>
                            <div class="absolute top-2.5 right-2.5 flex items-center gap-1">
                                <span class="px-2 py-0.5 rounded-md bg-black/60 backdrop-blur-sm border border-white/10 text-white text-[10px]">
                                    <%= room.isPrivate ? '🔒 Privada' : '🌐 Pública' %>
                                </span>
                            </div>
                            <div class="absolute bottom-2 left-2.5 right-2.5 flex items-center justify-between text-[11px] text-white font-bold">
                                <span class="truncate drop-shadow"><%= room.name || 'Sala' %></span>
                                <button type="button" class="btn-like-room flex items-center gap-1 px-2 py-0.5 rounded-lg bg-black/60 hover:bg-rose-600/80 text-rose-400 hover:text-white transition backdrop-blur-sm"
                                        data-room-id="<%= room.id %>" title="Curtir Sala">
                                    <span class="material-symbols-outlined text-[14px]">favorite</span>
                                    <span class="room-likes-count"><%= Number(room.likesCount || 0) %></span>
                                </button>
                            </div>
                        </div>

                        <p class="text-xs text-zinc-400 line-clamp-2"><%= room.description || 'Espaço virtual 3D interativo para reunir amigos.' %></p>

                        <!-- Indicadores Amigáveis da Sala -->
                        <div class="flex items-center justify-between text-[11px] text-zinc-400 py-1 border-t border-white/5">
                            <span class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-[15px] text-sky-400">visibility</span>
                                <span><%= totalVis.toLocaleString('pt-BR') %> visitas</span>
                            </span>
                            <span class="flex items-center gap-1 text-emerald-400">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                <span>Aberta para visitas</span>
                            </span>
                        </div>
                    </div>

                    <div class="space-y-2 pt-2.5 border-t border-white/5">
                        <div class="flex flex-wrap items-center justify-between gap-1.5">
                            <button type="button"
                                    class="btn-share-room-to-chat px-2.5 py-1.5 bg-sky-600/15 hover:bg-sky-600 border border-sky-500/30 text-sky-300 hover:text-white text-[10px] font-black rounded-xl transition flex items-center gap-1"
                                    data-room-id="<%= room.id %>"
                                    data-room-name="<%= room.name %>"
                                    title="Compartilhar sala no Chat">
                                <span class="material-symbols-outlined text-[14px]">share</span>
                                <span>Chat</span>
                            </button>
                            <div class="flex flex-wrap items-center gap-1.5">
                                <button type="button"
                                        class="btn-boost-room px-2 py-1.5 bg-amber-500/15 hover:bg-amber-500 hover:text-slate-950 border border-amber-500/30 text-amber-300 text-[10px] font-black rounded-xl transition flex items-center gap-1"
                                        data-id="<%= room.id %>"
                                        data-name="<%= room.name %>"
                                        title="Destacar sala no topo por 24h (<%= boostFeeCoins %> Coins)">
                                    🚀 <span>Boost</span>
                                </button>
                                <button type="button"
                                        class="btn-enter-room-pass px-2.5 py-1.5 bg-indigo-600/20 hover:bg-indigo-600 border border-indigo-500/30 text-indigo-300 hover:text-white text-[11px] font-bold rounded-xl transition flex items-center gap-1"
                                        data-id="<%= room.id %>"
                                        data-name="<%= room.name %>"
                                        data-entryvalue="<%= entryPrice %>"
                                        title="Entrar na Sala 3D">
                                    <span class="material-symbols-outlined text-[14px]">login</span>
                                    <span>Entrar</span>
                                </button>
                                <button type="button"
                                        class="btn-inspect-room px-2 py-1.5 bg-slate-800 hover:bg-blue-600 text-white text-[11px] font-bold rounded-xl transition flex items-center gap-1"
                                        data-id="<%= room.id %>"
                                        data-name="<%= room.name %>"
                                        data-description="<%= room.description || '' %>"
                                        data-maxplayers="<%= room.maxPlayers || 30 %>"
                                        data-entryvalue="<%= entryPrice %>"
                                        data-isprivate="<%= room.isPrivate %>"
                                        data-password="<%= room.password || '' %>">
                                    <span class="material-symbols-outlined text-[14px]">tune</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="col-span-full bg-slate-900/40 border border-dashed border-white/10 rounded-3xl p-8 text-center text-zinc-500 space-y-2">
                <span class="material-symbols-outlined text-3xl text-zinc-600">domain_disabled</span>
                <p class="text-xs font-bold text-zinc-400"><%= t('profile.rooms.empty', {}, 'Nenhuma sala criada.') %></p>
            </div>
        <% } %>
    </div>

    <!-- SUB-ABA 2: EXPLORADOR DE SALAS PÚBLICAS -->
    <div id="subtabRoomsExplore" class="rooms-subtab-panel hidden space-y-4">
        <div class="flex items-center justify-between">
            <h4 class="text-xs font-black uppercase tracking-wider text-amber-400 flex items-center gap-2">
                <i class="fa-solid fa-compass"></i>
                <span>Explorar Salas da Comunidade</span>
            </h4>
            <button type="button" id="btnRefreshPublicRooms" class="px-3 py-1.5 rounded-xl bg-slate-900 border border-white/10 hover:border-amber-500/40 text-[11px] font-bold text-zinc-300 hover:text-white transition flex items-center gap-1">
                <i class="fa-solid fa-rotate"></i> Atualizar
            </button>
        </div>

        <div id="publicRoomsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            <% if (pubRoomsList.length > 0) { %>
                <% pubRoomsList.forEach(function(room, idx) {
                    const entryPrice = Number(room.entryValue || 0);
                    const isPaid = entryPrice > 0;
                    const totalVis = Number(room.totalVisits || room.visits || 0);
                    const ownerAv = room.ownerAvatar || null;
                    const roomThumb = room.thumbnail || room.previewUrl || 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=600&q=80';
                %>
                    <div class="bg-slate-900/90 border <%= room.isBoosted ? 'border-amber-500/60 shadow-lg shadow-amber-500/10' : 'border-white/10' %> rounded-2xl p-4 space-y-3 flex flex-col justify-between">
                        <div class="space-y-2.5">
                            <!-- Preview da Sala 3D -->
                            <div class="h-32 rounded-xl overflow-hidden bg-slate-950 border border-white/5 relative group">
                                <img src="<%= roomThumb %>" alt="<%= room.name || 'Sala Pública' %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent"></div>
                                <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5">
                                    <span class="px-2 py-0.5 rounded-md <%= idx < 3 ? 'bg-amber-500 text-slate-950' : 'bg-slate-800 text-zinc-300' %> text-[10px] font-black">#<%= idx + 1 %></span>
                                    <% if (room.isBoosted) { %>
                                        <span class="px-2 py-0.5 rounded-md bg-gradient-to-r from-amber-500 to-yellow-400 text-slate-950 text-[9px] font-black uppercase">
                                            🚀 Destaque
                                        </span>
                                    <% } %>
                                </div>
                                <div class="absolute top-2.5 right-2.5">
                                    <% if (room.viewerHasActivePass) { %>
                                        <span class="px-2 py-0.5 rounded-md bg-emerald-500/90 text-white text-[10px] font-black">✔ Passe Ativo</span>
                                    <% } else if (isPaid) { %>
                                        <span class="px-2 py-0.5 rounded-md bg-amber-500/90 text-slate-950 text-[10px] font-black">🎟️ <%= entryPrice %> Coins</span>
                                    <% } else { %>
                                        <span class="px-2 py-0.5 rounded-md bg-emerald-500/90 text-white text-[10px] font-black">Livre</span>
                                    <% } %>
                                </div>
                                <div class="absolute bottom-2 left-2.5 right-2.5 flex items-center justify-between text-[11px] text-white font-bold">
                                    <span class="truncate drop-shadow"><%= room.name || 'Sala Pública' %></span>
                                    <button type="button" class="btn-like-room flex items-center gap-1 px-2 py-0.5 rounded-lg bg-black/60 hover:bg-rose-600/80 text-rose-400 hover:text-white transition backdrop-blur-sm"
                                            data-room-id="<%= room.id %>" title="Curtir Sala">
                                        <span class="material-symbols-outlined text-[14px]">favorite</span>
                                        <span class="room-likes-count"><%= Number(room.likesCount || 0) %></span>
                                    </button>
                                </div>
                            </div>

                            <% if (ownerAv) { %>
                                <div class="flex items-center gap-2 text-[11px] text-zinc-300">
                                    <img src="<%= ownerAv.thumbnail || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(ownerAv.name || 'Viajante') %>" class="w-5 h-5 rounded-full object-cover">
                                    <span class="truncate">Criado por <strong class="text-white"><%= ownerAv.name %></strong> <%= ownerAv.isVip ? '👑' : '' %></span>
                                </div>
                            <% } %>

                            <p class="text-xs text-zinc-400 line-clamp-2"><%= room.description || 'Espaço público 3D aberto para visitas e encontros.' %></p>

                            <div class="flex items-center justify-between text-[11px] text-zinc-400 py-1 border-t border-white/5">
                                <span class="flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[15px] text-sky-400">visibility</span>
                                    <span><%= totalVis.toLocaleString('pt-BR') %> visitas</span>
                                </span>
                                <span class="flex items-center gap-1 text-emerald-400">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                    <span>Aberta</span>
                                </span>
                            </div>
                        </div>

                        <div class="flex flex-wrap items-center justify-between gap-2 pt-2.5 border-t border-white/5">
                            <div></div>
                            <div class="flex items-center gap-1.5">
                                <button type="button"
                                        class="btn-share-room-to-chat px-2.5 py-1.5 bg-sky-600/20 hover:bg-sky-600 border border-sky-500/30 text-sky-300 hover:text-white text-[11px] font-bold rounded-xl transition flex items-center gap-1"
                                        data-room-id="<%= room.id %>"
                                        data-room-name="<%= room.name %>"
                                        title="Compartilhar sala no Chat">
                                    <span class="material-symbols-outlined text-[14px]">share</span>
                                    <span>Chat</span>
                                </button>
                                <button type="button"
                                        class="btn-enter-room-pass px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-black uppercase rounded-xl transition flex items-center gap-1"
                                        data-id="<%= room.id %>"
                                        data-name="<%= room.name %>"
                                        data-entryvalue="<%= entryPrice %>">
                                    <span class="material-symbols-outlined text-[15px]">login</span>
                                    <span>Visitar</span>
                                </button>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-span-full p-8 rounded-2xl bg-slate-900/40 border border-dashed border-white/10 text-center text-xs text-zinc-500">
                    Nenhuma sala pública disponível no momento.
                </div>
            <% } %>
        </div>
    </div>
</section>
