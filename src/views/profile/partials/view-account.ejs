<!-- ================= VIEW 4: CONTA USER (ICON-FIRST & I18N) ================= -->
<section id="view-profile" class="view-panel hidden p-4 sm:p-6 lg:p-8 max-w-4xl mx-auto w-full space-y-5">
    <div class="bg-slate-900/80 border border-white/10 rounded-3xl p-6 backdrop-blur-xl space-y-5">
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <h3 class="text-sm sm:text-base font-black uppercase italic tracking-wider text-white flex items-center gap-2">
                <span class="material-symbols-outlined text-[22px] text-blue-500">manage_accounts</span>
                <span><%= t('profile.account.title', {}, 'Conta') %></span>
            </h3>
            <span class="px-2.5 py-1 rounded-lg bg-slate-950 border border-white/10 text-[11px] font-mono text-zinc-400">ID #<%= user?.id %></span>
        </div>

        <form id="formUserGlobal" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="flex items-center gap-1.5 text-xs font-bold text-zinc-400 uppercase tracking-wider mb-1.5">
                        <span class="material-symbols-outlined text-[15px] text-blue-400">badge</span>
                        <span><%= t('profile.account.fullName', {}, 'Nome') %></span>
                    </label>
                    <input type="text" id="usrName" value="<%= user?.userName || '' %>" 
                           class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="flex items-center gap-1.5 text-xs font-bold text-zinc-400 uppercase tracking-wider mb-1.5">
                        <span class="material-symbols-outlined text-[15px] text-zinc-500">alternate_email</span>
                        <span><%= t('profile.account.login', {}, 'Login') %></span>
                    </label>
                    <input type="text" value="<%= user?.login || '' %>" readonly 
                           class="w-full bg-slate-950/50 border border-white/5 rounded-xl px-4 py-2.5 text-xs text-zinc-500 cursor-not-allowed">
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="flex items-center gap-1.5 text-xs font-bold text-zinc-400 uppercase tracking-wider mb-1.5">
                        <span class="material-symbols-outlined text-[15px] text-emerald-400">mail</span>
                        <span><%= t('profile.account.email', {}, 'E-mail') %></span>
                    </label>
                    <input type="email" id="usrEmail" value="<%= user?.email || '' %>" 
                           class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="flex items-center gap-1.5 text-xs font-bold text-zinc-400 uppercase tracking-wider mb-1.5">
                        <span class="material-symbols-outlined text-[15px] text-amber-400">call</span>
                        <span><%= t('profile.account.phone', {}, 'Telefone') %></span>
                    </label>
                    <input type="tel" id="usrPhone" value="<%= user?.phone || '' %>" 
                           class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-blue-500">
                </div>
            </div>

            <div class="pt-2 flex justify-end">
                <button type="button" id="btnSaveUserData" 
                        class="px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-xs font-bold uppercase tracking-wider transition shadow-lg shadow-blue-600/30 flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px]">save</span>
                    <span><%= t('profile.account.save', {}, 'Salvar') %></span>
                </button>
            </div>
        </form>
    </div>
</section>
