<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="The Fantasy Life - O Teu Lugar é aqui">
    <link rel="icon" href="/static/images/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=Inter:wght@300;400;600&display=swap" rel="stylesheet" />
    <title><%= typeof title !== 'undefined' ? title : 'The Fantasy Life' %></title>
    <style>
        :root {
            --font-display: "Outfit", sans-serif;
            --font-body: "Inter", sans-serif;
        }
        body {
            background-color: #050505;
            font-family: var(--font-body);
        }
        h1, h2, h3, .font-display {
            font-family: var(--font-display);
        }
        .hero-gradient {
            background: radial-gradient(circle at 50% -20%, #1e40af 0%, #050505 60%);
        }
    </style>
</head>
<body class="text-zinc-200 min-h-screen flex flex-col justify-between hero-gradient">
    <nav class="w-full z-50 border-b border-white/5 bg-black/60 backdrop-blur-xl">
        <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center">
            <a href="/" class="flex items-center gap-3">
                <img src="/static/images/Icon_tfl.png" alt="The Fantasy Life" class="w-10 h-10">
                <div class="text-xl font-display font-black tracking-tight uppercase italic">
                    The <span class="text-blue-500">Fantasy</span> Life
                </div>
            </a>
            <div class="flex gap-4">
                <a href="/" class="text-sm font-medium text-zinc-400 hover:text-white transition flex items-center gap-2">
                    <i class="fa-solid fa-house"></i>
                    <span><%= t('common.home', {}, 'common.home') || 'Início' %></span>
                </a>
            </div>
        </div>
    </nav>