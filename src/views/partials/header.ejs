<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'pt-BR' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('./seo-head') %>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&family=Inter:wght@300;400;600&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --font-display: "Outfit", sans-serif;
            --font-body: "Inter", sans-serif;
        }
        body {
            background-color: #050505;
            font-family: var(--font-body);
        }
        h1, h2, h3, .font-display {
            font-family: var(--font-display);
        }
        .hero-gradient {
            background: radial-gradient(circle at 50% -20%, #1e40af 0%, #050505 60%);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 20;
            vertical-align: middle;
            line-height: 1;
        }
        @keyframes tflToastProgress {
            from { width: 100%; }
            to { width: 0%; }
        }
        .tfl-toast-progress {
            animation: tflToastProgress linear forwards;
        }
    </style>
</head>
<body class="text-zinc-200 min-h-screen flex flex-col justify-between hero-gradient">
    <% if (typeof hideHeader === 'undefined' || !hideHeader) { %>
    <nav class="w-full z-50 border-b border-white/5 bg-black/60 backdrop-blur-xl">
        <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center">
            <a href="/" class="flex items-center gap-3">
                <img src="/static/images/Icon_tfl.png" alt="The Fantasy Life" class="w-10 h-10">
                <div class="text-xl font-display font-black tracking-tight uppercase italic">
                    The <span class="text-blue-500">Fantasy</span> Life
                </div>
            </a>
            <div class="flex items-center gap-4">
                <a href="/" class="text-sm font-medium text-zinc-400 hover:text-white transition flex items-center gap-1.5" title="Início">
                    <span class="material-symbols-outlined text-[18px]">home</span>
                    <span><%= t('common.home', {}, 'Início') %></span>
                </a>
            </div>
        </div>
    </nav>
    <% } %>