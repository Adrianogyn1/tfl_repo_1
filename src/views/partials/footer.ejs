<footer class="py-6 border-t border-white/10 bg-zinc-950/95 px-6 mt-auto z-30">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="text-center md:text-left">
            <div class="text-base font-display font-black uppercase italic text-white">
                The <span class="text-blue-500">Fantasy</span> Life
            </div>
            <p class="text-zinc-500 text-xs italic">
                <%= t('home.footer.slogan', {}, 'Onde a tua imaginação ganha forma digital.') %>
            </p>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-4">
            <a href="/tutorial" class="px-3.5 py-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-blue-500/40 text-zinc-300 hover:text-white text-xs font-bold transition flex items-center gap-2" title="<%= t('home.nav.tutorial', {}, 'Tutorial de Como Usar o Site') %>">
                <span class="material-symbols-outlined text-[16px] text-blue-400">help</span>
                <span><%= t('home.nav.tutorial', {}, 'Tutorial & Ajuda') %></span>
            </a>

            <div class="flex items-center gap-2 bg-zinc-900 border border-zinc-800 rounded-xl px-3 py-1.5">
                <span class="material-symbols-outlined text-[16px] text-zinc-400">translate</span>
                <select id="langSelect"
                    aria-label="Selecionar Idioma"
                    class="bg-transparent text-zinc-200 text-xs font-semibold focus:outline-none cursor-pointer">
                    <option value="pt-BR" class="bg-zinc-900">Português (Brasil)</option>
                    <option value="en-US" class="bg-zinc-900">English (US)</option>
                    <option value="es-ES" class="bg-zinc-900">Español</option>
                </select>
            </div>
        </div>
    </div>
    <div class="text-center mt-4 text-zinc-600 text-[10px]">
        © The Fantasy Life. <%= t('home.footer.rights', {}, 'Todos os direitos reservados.') %>
    </div>
</footer>

<script>
    $(document).ready(function () {
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        const rawLang = getCookie('lang') || '<%= typeof currentLang !== "undefined" ? currentLang : "pt-BR" %>';
        const normLang = rawLang.startsWith('en') ? 'en-US' : (rawLang.startsWith('es') ? 'es-ES' : 'pt-BR');
        $('#langSelect').val(normLang);

        $(document).on('change', '#langSelect', function () {
            const selectedLang = $(this).val() || 'pt-BR';
            document.cookie = `lang=${selectedLang}; path=/; max-age=31536000`;
            $.post('/profile/locale', { lang: selectedLang }).always(function () {
                location.reload();
            });
        });

        // Registra telemetria de visita e região (fuso/idioma) para o painel Admin
        try {
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
            const navLang = navigator.language || '';
            fetch('/api/visit-beacon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    path: window.location.pathname,
                    timezone: tz,
                    language: navLang
                })
            }).catch(function () {});
        } catch (_) {}
    });
</script>
</body>

</html>