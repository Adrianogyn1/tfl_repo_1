<%- include('partials/header', { title: typeof title !== 'undefined' ? title : t('changelog.heroTitle', {}, 'Notas de Atualização do Sistema') }) %>

<main class="w-full flex-1 max-w-5xl mx-auto px-4 sm:px-6 py-10 md:py-16">
    <!-- Hero / Topo da Página Dedicada -->
    <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold uppercase tracking-wider mb-4">
            <span class="material-symbols-outlined text-[16px]">history_edu</span>
            <span><%= t('changelog.heroBadge', {}, 'Transparência & Evolução da Plataforma') %></span>
        </div>
        <h1 class="text-3xl md:text-5xl font-black text-white tracking-tight font-display mb-3">
            <%= t('changelog.heroTitle', {}, 'Notas de Atualização do Sistema') %>
        </h1>
        <p class="text-zinc-400 text-sm md:text-base leading-relaxed">
            <%= t('changelog.heroSubtitle', {}, 'Acompanhe cada novidade, melhoria de estabilidade e o status das funcionalidades em desenvolvimento no The Fantasy Life.') %>
        </p>

        <!-- Card da Versão Atual Canônica -->
        <div class="mt-8 inline-flex flex-col sm:flex-row items-center gap-4 bg-zinc-900/90 border border-white/10 px-6 py-4 rounded-3xl shadow-xl backdrop-blur-xl">
            <div class="flex items-center gap-3">
                <span class="flex h-3 w-3 relative">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                </span>
                <div class="text-left">
                    <div class="text-[11px] font-bold uppercase tracking-wider text-zinc-400"><%= t('changelog.currentVersionBadge', {}, 'Versão Estável Atual') %></div>
                    <div class="text-2xl font-black font-mono text-white tracking-wide">v<%= typeof version !== 'undefined' ? version : '0.00042' %></div>
                </div>
            </div>
            <div class="hidden sm:block h-8 w-px bg-white/10"></div>
            <div class="text-left text-xs text-zinc-400">
                <div class="text-zinc-200 font-semibold"><%= typeof versionInfo !== 'undefined' && versionInfo.releaseName ? versionInfo.releaseName : 'Atualização Contínua' %></div>
                <div><%= t('changelog.publishedOn', {}, 'Publicado em') %> <%= typeof versionInfo !== 'undefined' && versionInfo.releaseDate ? versionInfo.releaseDate : '14 de Outubro de 2026' %></div>
            </div>
        </div>
    </div>

    <!-- 3 Blocos Principais da Versão Ativa -->
    <div class="space-y-8 mb-16">
        <!-- 1. O Que Há de Novo -->
        <div class="bg-zinc-950/70 border border-emerald-500/20 rounded-3xl p-6 sm:p-8 backdrop-blur-xl shadow-xl">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
                    <span class="material-symbols-outlined text-[22px]">auto_awesome</span>
                </div>
                <div>
                    <h2 class="text-xl font-bold text-white font-display"><%= t('changelog.whatsNewTitle', {}, 'O Que Há de Novo') %></h2>
                    <p class="text-xs text-zinc-400"><%= t('changelog.whatsNewDesc', {}, 'Novos recursos e experiências implementadas nesta versão.') %></p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <% if (typeof versionInfo !== 'undefined' && versionInfo.whatsNew && versionInfo.whatsNew.length > 0) { %>
                    <% versionInfo.whatsNew.forEach(function(item) { %>
                        <div class="bg-zinc-900/60 border border-white/5 rounded-2xl p-4 flex gap-3.5 items-start">
                            <span class="material-symbols-outlined text-[18px] text-emerald-400 mt-0.5">check_circle</span>
                            <div>
                                <h3 class="text-sm font-bold text-zinc-100 mb-1"><%= typeof item === 'object' && item.title ? item.title : item %></h3>
                                <p class="text-xs text-zinc-400 leading-relaxed"><%= typeof item === 'object' && item.description ? item.description : '' %></p>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-span-2 text-xs text-zinc-500 italic p-4">Nenhuma nova funcionalidade listada no momento.</div>
                <% } %>
            </div>
        </div>

        <!-- 2. O Que Foi Corrigido -->
        <div class="bg-zinc-950/70 border border-blue-500/20 rounded-3xl p-6 sm:p-8 backdrop-blur-xl shadow-xl">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-2xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400">
                    <span class="material-symbols-outlined text-[22px]">build</span>
                </div>
                <div>
                    <h2 class="text-xl font-bold text-white font-display"><%= t('changelog.fixesTitle', {}, 'O Que Foi Corrigido') %></h2>
                    <p class="text-xs text-zinc-400"><%= t('changelog.fixesDesc', {}, 'Estabilidade, fluidez e correções de comportamentos relatados.') %></p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <% if (typeof versionInfo !== 'undefined' && versionInfo.fixes && versionInfo.fixes.length > 0) { %>
                    <% versionInfo.fixes.forEach(function(item) { %>
                        <div class="bg-zinc-900/60 border border-white/5 rounded-2xl p-4 flex gap-3.5 items-start">
                            <span class="material-symbols-outlined text-[18px] text-blue-400 mt-0.5">task_alt</span>
                            <div>
                                <h3 class="text-sm font-bold text-zinc-100 mb-1"><%= typeof item === 'object' && item.title ? item.title : item %></h3>
                                <p class="text-xs text-zinc-400 leading-relaxed"><%= typeof item === 'object' && item.description ? item.description : '' %></p>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-span-2 text-xs text-zinc-500 italic p-4">Nenhuma correção específica nesta compilação.</div>
                <% } %>
            </div>
        </div>

        <!-- 3. Bugs Conhecidos & Em Investigação -->
        <div class="bg-zinc-950/70 border border-amber-500/20 rounded-3xl p-6 sm:p-8 backdrop-blur-xl shadow-xl">
            <div class="flex items-center justify-between flex-wrap gap-4 mb-6">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400">
                        <span class="material-symbols-outlined text-[22px]">troubleshoot</span>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-white font-display"><%= t('changelog.bugsTitle', {}, 'Bugs Conhecidos & Em Investigação') %></h2>
                        <p class="text-xs text-zinc-400"><%= t('changelog.bugsDesc', {}, 'Problemas identificados que estão atualmente em processo de solução.') %></p>
                    </div>
                </div>
                <a href="/reportar-bug"
                    class="px-4 py-2 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 text-amber-300 text-xs font-bold transition flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[16px]">pest_control</span>
                    <span><%= t('changelog.reportOtherBug', {}, 'Reportar Outro Problema') %></span>
                </a>
            </div>

            <div class="space-y-3">
                <% if (typeof versionInfo !== 'undefined' && versionInfo.knownBugs && versionInfo.knownBugs.length > 0) { %>
                    <% versionInfo.knownBugs.forEach(function(item) { %>
                        <div class="bg-zinc-900/60 border border-white/5 rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <div class="flex gap-3 items-start">
                                <span class="material-symbols-outlined text-[18px] text-amber-400 mt-0.5">warning</span>
                                <div>
                                    <h3 class="text-sm font-bold text-zinc-100"><%= typeof item === 'object' && item.title ? item.title : item %></h3>
                                    <p class="text-xs text-zinc-400 mt-0.5"><%= typeof item === 'object' && item.description ? item.description : '' %></p>
                                </div>
                            </div>
                            <span class="inline-flex self-start sm:self-center px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-500/10 text-amber-300 border border-amber-500/20 whitespace-nowrap">
                                <%= (typeof item === 'object' && item.status) ? item.status : 'Investigando' %>
                            </span>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="text-xs text-zinc-500 italic p-4">Nenhum bug crítico conhecido pendente nesta versão.</div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Histórico de Versões / Changelog Timeline -->
    <% if (typeof changelog !== 'undefined' && changelog && changelog.length > 1) { %>
        <div class="border-t border-white/10 pt-10">
            <h2 class="text-xl font-bold text-white font-display mb-6 flex items-center gap-2">
                <span class="material-symbols-outlined text-blue-400">schedule</span>
                <span><%= t('changelog.historyTitle', {}, 'Histórico de Atualizações Anteriores') %></span>
            </h2>

            <div class="space-y-4">
                <% changelog.forEach(function(rel, idx) { %>
                    <% if (idx > 0) { %>
                        <div class="bg-zinc-900/40 border border-white/5 rounded-2xl p-5 hover:border-white/10 transition">
                            <div class="flex items-center justify-between mb-2">
                                <div class="flex items-center gap-2">
                                    <span class="px-2.5 py-0.5 rounded-full bg-zinc-800 text-zinc-300 font-mono text-xs font-bold">
                                        v<%= rel.version %>
                                    </span>
                                    <span class="text-sm font-bold text-white"><%= rel.releaseName %></span>
                                </div>
                                <span class="text-xs text-zinc-500"><%= rel.releaseDate %></span>
                            </div>
                            <p class="text-xs text-zinc-400 mb-3"><%= rel.summary %></p>
                            <% if (rel.fixes && rel.fixes.length > 0) { %>
                                <ul class="text-[11px] text-zinc-400 space-y-1 pl-4 list-disc marker:text-blue-500">
                                    <% rel.fixes.forEach(function(f) { %>
                                        <li><%= typeof f === 'string' ? f : f.title %></li>
                                    <% }); %>
                                </ul>
                            <% } %>
                        </div>
                    <% } %>
                <% }); %>
            </div>
        </div>
    <% } %>

    <!-- Chamada para Ação / Feedback Comunitário -->
    <div class="mt-14 bg-gradient-to-r from-blue-900/30 to-purple-900/30 border border-blue-500/20 rounded-3xl p-8 text-center">
        <h3 class="text-xl font-bold text-white font-display mb-2"><%= t('changelog.communityCtaTitle', {}, 'Construa o The Fantasy Life Conosco') %></h3>
        <p class="text-xs sm:text-sm text-zinc-300 max-w-xl mx-auto mb-6">
            <%= t('changelog.communityCtaDesc', {}, 'Sua opinião é fundamental para lapidarmos o ambiente 3D, rede social e economia do jogo.') %>
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
            <a href="/contato" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs uppercase tracking-wider transition shadow-lg shadow-blue-600/30">
                <%= t('changelog.contactBtn', {}, 'Fale Conosco') %>
            </a>
            <a href="/reportar-bug" class="px-5 py-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-700 text-zinc-200 text-xs font-bold transition">
                <%= t('changelog.reportBugBtn', {}, 'Reportar Bug') %>
            </a>
            <a href="/sugestoes" class="px-5 py-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-700 text-zinc-200 text-xs font-bold transition">
                <%= t('changelog.suggestionBtn', {}, 'Enviar Sugestão') %>
            </a>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
